---
// Big photos that stack as you scroll: each panel pins to the top of the page and the next one
// slides up over it, with a soft shadow along its edge. Each photo
// is a patch sewn onto the page's cotton (the same stitched outline as the cart's hover box, and the
// product photos' shadow down-left), with its name in your sewn lettering on the cotton underneath,
// alternating left and right, a little crooked like a hand-sewn label. The whole panel is a link;
// hovering it shows the word's sewn underline, like the header tabs.
//
// The page scrolls inside <main> (under the header), so a panel is as tall as that area, not the
// window: the script at the bottom measures it. People who've turned off animations get the panels
// one after another, without the stacking.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Drawn from './Drawn.astro';
import { drawn } from '../data/assets';

export type Panel = {
  img: ImageMetadata;
  alt: string;
  /** A drawing in src/assets/drawn/ (e.g. "filter-thermals"): the sewn word under the photo. */
  title: string;
  /** What the word says, for screen readers. */
  label: string;
  href: string;
  /** Which part of the photo stays in view (CSS object-position), on computers and on phones. */
  pos?: string;
  posPhone?: string;
  /** The photo runs the full width of the page, edge to edge, instead of a patch with cotton around
   *  it (stitched along the bottom, where it meets the cotton), with a bigger name. */
  full?: boolean;
};

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;
// Each label sits a little crooked, the way a hand-sewn one would.
const TILTS = ['-1.2deg', '0.9deg', '-0.6deg', '1.3deg', '-1deg'];
---

<section class="stackp" data-stackp>
  {
    panels.map((p, i) => (
      <a
        class="panel"
        href={p.href}
        aria-label={p.label}
        data-side={i % 2 ? 'right' : 'left'}
        data-full={p.full ? '' : undefined}
        style={`--z:${i + 1};--pos:${p.pos ?? '50% 50%'};--pos-phone:${p.posPhone ?? p.pos ?? '50% 50%'};--tilt:${TILTS[i % TILTS.length]}`}
      >
        <span class:list={['patch', { 'sewn-box': !p.full }]}>
          <Image
            src={p.img}
            alt={p.alt}
            class="media"
            widths={[640, 960, 1400, 1800, 2400].filter((w) => w <= p.img.width)}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </span>
        <span class="label">
          <Drawn name={p.title} h={30} webH={p.full ? 84 : 60} loading={i === 0 ? 'eager' : 'lazy'} underline={!!drawn(`${p.title}-line`)} />
        </span>
      </a>
    ))
  }
</section>

<script>
  // A panel is about as tall as the scrolling area under the header, so the next one's edge peeks in
  // at the bottom. Measured once, and again only when the width changes, so a phone's address bar
  // sliding in and out doesn't make the panels jump.
  const stack = document.querySelector<HTMLElement>('[data-stackp]');
  const main = document.querySelector('main');
  if (stack && main) {
    let lastW = 0;
    const measure = () => {
      if (main.clientWidth === lastW) return;
      lastW = main.clientWidth;
      stack.style.setProperty('--area-h', `${main.clientHeight}px`);
    };
    measure();
    addEventListener('resize', measure);
  }
</script>

<style>
  .stackp {
    --area-h: calc(100svh - 100px); /* until the script measures it */
    --panel-h: calc(var(--area-h) * 0.94);
    --side: 32px; /* cotton around the patch */
    --top: 38px;
    --strip: 104px; /* the cotton under the patch, where its name is sewn */
    position: relative;
    isolation: isolate;
  }

  .panel {
    position: sticky;
    top: 0;
    z-index: var(--z);
    display: block;
    height: var(--panel-h);
    color: inherit;
    text-decoration: none;
    background: var(--fabric);
  }

  /* Each next panel is a fresh piece of cotton laid over the one before: just a soft shadow along its
     top edge (no stitch line, so once it pins under the header there's only the header's line, then
     the patch's outline). */
  .panel:not(:first-child) {
    box-shadow: 0 -10px 18px -10px rgba(31, 27, 22, 0.32);
  }

  /* The photo: a patch, stitched on just outside its edge, with a shadow down-left like the product
     photos. */
  .patch {
    --sew: 9px;
    position: absolute;
    top: var(--top);
    left: var(--side);
    right: var(--side);
    bottom: var(--strip);
    box-shadow: -6px 7px 14px rgba(31, 27, 22, 0.2);
  }

  .patch :global(.media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }

  /* The name, sewn on the cotton under the patch, a little crooked. */
  .label {
    position: absolute;
    left: var(--side);
    bottom: calc(var(--strip) / 2 - 30px);
    transform: rotate(var(--tilt));
    transform-origin: left center;
  }

  .panel[data-side='right'] .label {
    left: auto;
    right: var(--side);
    transform-origin: right center;
  }

  /* A full-width photo: edge to edge from the top, no outline (its sides would run off the page),
     just the stitch line along the bottom where it meets the cotton. */
  .panel[data-full] .patch {
    top: 0;
    left: 0;
    right: 0;
    box-shadow: none;
  }

  .panel[data-full] .patch::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -10px;
    height: 7px;
    background: url('../assets/stitch-bottom.png') left center / auto 7px repeat-x;
    pointer-events: none;
  }

  @media (min-width: 700px) {
    .panel[data-full] .label {
      bottom: calc(var(--strip) / 2 - 42px);
    }
  }

  .panel:focus-visible {
    outline: none;
  }

  .panel:focus-visible .patch {
    outline: 2px dashed var(--red);
    outline-offset: 16px;
  }

  @media (max-width: 699px) {
    .stackp {
      --panel-h: calc(var(--area-h) * 0.9);
      --side: 18px;
      --top: 24px;
      --strip: 62px;
    }

    .patch {
      --sew: 7px;
    }

    .patch :global(.media) {
      object-position: var(--pos-phone);
    }

    .label {
      bottom: calc(var(--strip) / 2 - 15px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      position: relative;
    }
  }
</style>
