---
// Big photos that stack as you scroll: each one fills the page's width and pins to the top, and the
// next slides up over it, with a thin strip of the page's cotton between them. Each has a big white
// title in the site's typewriter font in bold, at the bottom of that photo's spot on the page, above all the
// photos, so the titles scroll by while the photos stay put. A photo that's mostly white (the
// sewing scan) gets a dark title instead.
//
// The page scrolls inside <main> (under the header), so a panel is as tall as that area, not the
// window: the script at the bottom measures it. People who've turned off animations get the photos
// one after another, without the stacking.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// The titles are the site's typewriter font (IBM Plex Mono) in bold; only this page loads the bold.
import '@fontsource/ibm-plex-mono/latin-700.css';

export type Panel = {
  img: ImageMetadata;
  alt: string;
  /** The big title. A line break ("made in\nseattle") splits it, the second line on the right. */
  title: string;
  /** Where the photo and its title go; leave out for a photo that isn't a link. */
  href?: string;
  /** Which part of the photo stays in view (CSS object-position), on computers and on phones. */
  pos?: string;
  posPhone?: string;
  /** A dark title, for a light photo. */
  dark?: boolean;
};

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;
---

<section class="stackp" data-stackp>
  {
    panels.map((p, i) => {
      const Tag = p.href ? 'a' : 'div';
      return (
        <Tag
          class:list={['panel', { light: p.dark }]}
          href={p.href}
          tabindex={p.href ? '-1' : undefined}
          aria-hidden="true"
          style={`--z:${i + 1};--pos:${p.pos ?? '50% 50%'};--pos-phone:${p.posPhone ?? p.pos ?? '50% 50%'}`}
        >
          <Image
            src={p.img}
            alt=""
            class="media"
            widths={[640, 960, 1400, 1800, 2400].filter((w) => w <= p.img.width)}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </Tag>
      );
    })
  }
  {
    panels.map((p, i) => {
      const Tag = p.href ? 'a' : 'div';
      return (
        <Tag class:list={['title', { dark: p.dark }]} href={p.href} style={`--slot:${i + 1}`} role={p.href ? undefined : 'img'} aria-label={`${p.title.replace(/\n/g, ' ')}. ${p.alt}`}>
          <span class="words" aria-hidden="true">
            {p.title.split('\n').map((line) => (
              <span class="line">{line}</span>
            ))}
          </span>
        </Tag>
      );
    })
  }
</section>

<script>
  // A panel is 92% as tall as the scrolling area under the header (80% on phones), so the next
  // photo peeks in at the bottom. Measured once, and again only when the width changes, so a phone's
  // address bar sliding in and out doesn't make the panels jump.
  const stack = document.querySelector<HTMLElement>('[data-stackp]');
  const main = document.querySelector('main');
  if (stack && main) {
    let lastW = 0;
    const measure = () => {
      if (main.clientWidth === lastW) return;
      lastW = main.clientWidth;
      stack.style.setProperty('--area-h', `${main.clientHeight}px`);
    };
    measure();
    addEventListener('resize', measure);
  }
</script>

<style>
  .stackp {
    --area-h: calc(100svh - 100px); /* until the script measures it */
    --panel-h: calc(var(--area-h) * 0.92);
    --pad: 22px;
    position: relative;
    isolation: isolate;
  }

  .panel {
    position: sticky;
    top: 0;
    z-index: var(--z);
    display: block;
    height: var(--panel-h);
    overflow: hidden;
    background: var(--ink);
  }

  /* A thin strip of the page's cotton between one photo and the next. */
  .panel:not(:first-child) {
    border-top: 4px solid var(--page);
  }

  .panel :global(.media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }

  /* A soft dark fade at the bottom, so the white title reads on any photo. */
  .panel:not(.light)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 16, 12, 0.4) 0%, rgba(20, 16, 12, 0) 50%);
    pointer-events: none;
  }

  /* The titles: one per photo, at the bottom of that photo's spot on the page, above all the photos. */
  .title {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--slot) * var(--panel-h));
    transform: translateY(-100%);
    z-index: 50;
    padding: 0 var(--pad) calc(var(--panel-h) * 0.05);
    color: #fff;
    text-decoration: none;
    pointer-events: none;
  }

  .title.dark {
    color: var(--ink);
  }

  a.title > * {
    pointer-events: auto;
  }

  .words {
    display: block;
    font-family: var(--type);
    font-weight: 700;
    font-size: clamp(56px, 13vw, 210px);
    line-height: 0.88;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .title:not(.dark) .words {
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.18);
  }

  .line {
    display: block;
  }

  .line + .line {
    text-align: right;
  }

  a.title:focus-visible {
    outline: none;
  }

  a.title:focus-visible .words {
    outline: 2px dashed currentColor;
    outline-offset: 6px;
  }

  @media (max-width: 699px) {
    .stackp {
      --panel-h: calc(var(--area-h) * 0.8);
      --pad: 14px;
    }

    .panel :global(.media) {
      object-position: var(--pos-phone);
    }

    .words {
      font-size: 17vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      position: relative;
    }
  }
</style>
