---
// Big photos that stack as you scroll: each one fills the page's width and pins to the top, and the
// next slides up over it, with a thin strip of the page's cotton between them. Each has a big white
// title in Rubik (see the font imports), at the bottom of that photo's spot on the page, above all the
// photos, so the titles scroll by while the photos stay put. A photo that's mostly white (the
// sewing scan) gets a dark title instead.
//
// A photo marked `pan` stays pinned a little longer while you scroll through it, top to bottom,
// before the next one comes up (its title stays at the bottom meanwhile, then rides up like the rest).
//
// The page scrolls inside <main> (under the header), so a panel is as tall as that area, not the
// window: the script at the bottom measures it. People who've turned off animations get the photos
// one after another, without the stacking.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// The titles: Rubik Black (round and chunky, with lowercase), and GÜSH in its all-capitals sibling,
// Rubik Mono One. Only this page loads them.
import '@fontsource/rubik/latin-900.css';
import '@fontsource/rubik-mono-one/latin-400.css';
// Fetched right away (not when the titles first show), so they're ready sooner.
import rubikFont from '@fontsource/rubik/files/rubik-latin-900-normal.woff2?url';
import rubikMonoFont from '@fontsource/rubik-mono-one/files/rubik-mono-one-latin-400-normal.woff2?url';

export type Panel = {
  img: ImageMetadata;
  alt: string;
  /** The big title (leave out for none). A line break ("made in\nseattle") splits it, the second
   *  line on the right. */
  title?: string;
  /** Where the photo and its title go; leave out for a photo that isn't a link. */
  href?: string;
  /** Which part of the photo stays in view (CSS object-position), on computers and on phones. */
  pos?: string;
  posPhone?: string;
  /** A dark title, for a light photo. */
  dark?: boolean;
  /** A squatter, flatter title with the letters closer together (the GÜSH one). */
  squat?: boolean;
  /** Scroll through the whole photo, top to bottom, before the next one comes up (when it's taller
   *  than the panel, as on computers). One per page. */
  pan?: boolean;
  /** A different photo for phones (whose panels are tall), e.g. the uncropped tall original. */
  imgPhone?: ImageMetadata;
};

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;

// Sharp copies at a few widths; a phone photo, if given, swaps in on narrow screens (only one of the
// two is downloaded).
const WIDTHS = [640, 960, 1400, 1800, 2400];
const srcset = async (img: ImageMetadata) => {
  const ws = WIDTHS.filter((w) => w <= img.width);
  const out = await Promise.all(ws.map((w) => getImage({ src: img, width: w, format: 'webp' })));
  return { srcset: out.map((o, k) => `${o.src} ${ws[k]}w`).join(', '), src: out[Math.min(2, out.length - 1)].src };
};
const sets = await Promise.all(panels.map(async (p) => ({ main: await srcset(p.img), phone: p.imgPhone ? await srcset(p.imgPhone) : undefined })));
const panAt = panels.findIndex((p) => p.pan);
---

<link rel="preload" as="font" type="font/woff2" href={rubikFont} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={rubikMonoFont} crossorigin />
<section class="stackp" data-stackp>
  {
    panels.map((p, i) => {
      const Tag = p.href ? 'a' : 'div';
      return (
        <Fragment>
        <Tag
          class:list={['panel', { light: p.dark }]}
          href={p.href}
          tabindex={p.href ? '-1' : undefined}
          aria-hidden="true"
          data-pan={p.pan ? '' : undefined}
          style={`--z:${i + 1};--pos:${p.pos ?? '50% 50%'};--pos-phone:${p.posPhone ?? p.pos ?? '50% 50%'}`}
        >
          <picture>
            {sets[i].phone && <source media="(max-width: 699px)" srcset={sets[i].phone!.srcset} sizes="100vw" />}
            <img
              class="media"
              src={sets[i].main.src}
              srcset={sets[i].main.srcset}
              sizes="100vw"
              alt=""
              width={p.img.width}
              height={p.img.height}
              decoding="async"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          </picture>
        </Tag>
        {p.pan && <div class="pan-space" aria-hidden="true" />}
        </Fragment>
      );
    })
  }
  {
    panels.map((p, i) => {
      if (!p.title) return null;
      const Tag = p.href ? 'a' : 'div';
      const words = (
        <span class="words" aria-hidden="true">
          {p.title.split('\n').map((line) => (
            <span class="line">{[...line].map((ch) => <span class="ch">{ch}</span>)}</span>
          ))}
        </span>
      );
      // The `pan` photo's title stays at the bottom while you scroll through that photo, then rides up
      // with the next one like the others: it sticks to the bottom of a slot as tall as that photo's
      // whole stretch of the page.
      if (p.pan)
        return (
          <div class="pan-slot">
            <Tag class:list={['title', 'pan-title', { dark: p.dark, squat: p.squat }]} href={p.href} aria-label={`${p.title.replace(/\n/g, ' ')}. ${p.alt}`}>
              {words}
            </Tag>
          </div>
        );
      return (
        <Tag class:list={['title', { dark: p.dark, 'after-pan': panAt >= 0 && i > panAt }]} href={p.href} style={`--slot:${i + 1}`} role={p.href ? undefined : 'img'} aria-label={`${p.title.replace(/\n/g, ' ')}. ${p.alt}`}>
          {words}
        </Tag>
      );
    })
  }
</section>

<script>
  // A panel is 92% as tall as the scrolling area under the header (80% on phones), so the next
  // photo peeks in at the bottom. Measured once, and again only when the width changes, so a phone's
  // address bar sliding in and out doesn't make the panels jump.
  const stack = document.querySelector<HTMLElement>('[data-stackp]');
  const main = document.querySelector('main');
  if (stack && main) {
    let lastW = 0;
    const measure = () => {
      if (main.clientWidth === lastW) return;
      lastW = main.clientWidth;
      stack.style.setProperty('--area-h', `${main.clientHeight}px`);
    };
    measure();
    addEventListener('resize', measure);

    // Titles: space each pair of letters so they just barely touch. Even letter-spacing can't do it
    // (round and straight letters meet differently), so each letter's real shape is drawn on a
    // canvas, the closest point to its neighbor found row by row, and the gap set to overlap by a hair.
    const OVERLAP = 0.008; // in em, between letters
    const EDGE_OVERLAP = 0.02; // in em, into the white borders at the left and bottom
    const fit = async () => {
      const words = [...stack.querySelectorAll<HTMLElement>('.words')];
      if (!words.length || !document.fonts) return;
      await document.fonts.ready;
      const S = 200;
      const shape = (font: string, ch: string) => {
        const c = document.createElement('canvas');
        c.width = 520;
        c.height = 320;
        const x = c.getContext('2d', { willReadFrequently: true })!;
        x.font = font;
        (x as CanvasRenderingContext2D & { fontKerning: string }).fontKerning = 'none';
        x.fillText(ch, 160, 240);
        const d = x.getImageData(0, 0, 520, 320).data;
        const L: (number | null)[] = [];
        const R: (number | null)[] = [];
        for (let y = 0; y < 320; y++) {
          let l = -1;
          let r = -1;
          for (let i = 0; i < 520; i++) if (d[(y * 520 + i) * 4 + 3] > 110) (l < 0 && (l = i), (r = i));
          L.push(l < 0 ? null : l - 160);
          R.push(r < 0 ? null : r - 160);
        }
        let bottom = 0; // lowest row with ink
        for (let y = 0; y < 320; y++) if (L[y] != null) bottom = y;
        const m = x.measureText(ch);
        return { L, R, adv: m.width, inkBelow: bottom - 240, asc: m.fontBoundingBoxAscent, desc: m.fontBoundingBoxDescent };
      };
      // Where each title's ink actually sits (letters have room around them in their box), so it
      // can be nudged into the photo's bottom-left corner, overlapping both edges by a hair.
      const corner = (w: HTMLElement, shapes: ReturnType<typeof shape>[][]) => {
        const title = w.closest<HTMLElement>('.title');
        const lines = [...w.querySelectorAll<HTMLElement>('.line')];
        const first = lines[0]?.querySelector<HTMLElement>('.ch');
        const lastChars = [...(lines.at(-1)?.querySelectorAll<HTMLElement>('.ch') ?? [])];
        if (!title || !first || !lastChars.length) return;
        w.style.translate = '';
        const t = title.getBoundingClientRect();
        const f = first.getBoundingClientRect();
        const s0 = shapes[0][0];
        const sx = f.width / s0.adv; // px on screen per canvas px (includes any squashing)
        const minL = Math.min(...(s0.L.filter((v) => v != null) as number[]));
        const inkLeft = f.left + minL * sx;
        const lastShapes = shapes.at(-1)!;
        let inkBottom = -Infinity;
        lastChars.forEach((el, i) => {
          const r = el.getBoundingClientRect();
          const sh = lastShapes[i];
          const sy = r.height / (sh.asc + sh.desc);
          inkBottom = Math.max(inkBottom, r.top + (sh.asc + sh.inkBelow + 1) * sy);
        });
        const px = parseFloat(getComputedStyle(w).fontSize) * EDGE_OVERLAP;
        w.style.translate = `${(t.left - px - inkLeft).toFixed(2)}px ${(t.bottom + px - inkBottom).toFixed(2)}px`;
      };
      const all: [HTMLElement, ReturnType<typeof shape>[][]][] = [];
      for (const w of words) {
        const cs = getComputedStyle(w);
        const font = `${cs.fontWeight} ${S}px ${cs.fontFamily}`;
        const perLine: ReturnType<typeof shape>[][] = [];
        all.push([w, perLine]);
        for (const line of w.querySelectorAll<HTMLElement>('.line')) {
          const chars = [...line.querySelectorAll<HTMLElement>('.ch')];
          const shapes = chars.map((el) => shape(font, el.textContent ?? ''));
          perLine.push(shapes);
          chars.forEach((el, i) => {
            if (i === chars.length - 1) return;
            const a = shapes[i];
            const b = shapes[i + 1];
            let gap = Infinity;
            for (let y = 0; y < 320; y++) {
              if (a.R[y] == null || b.L[y] == null) continue;
              gap = Math.min(gap, a.adv + (b.L[y] as number) - (a.R[y] as number) - 1);
            }
            if (Number.isFinite(gap)) el.style.marginRight = `${(-gap / S - OVERLAP).toFixed(4)}em`;
          });
        }
        w.classList.add('fitted');
      }
      const place = () => all.forEach(([w, s]) => corner(w, s));
      requestAnimationFrame(() => {
        place();
        stack.classList.add('titles-ready'); // show them now: right font, spaced, in place
      });
      let lastW2 = innerWidth;
      addEventListener('resize', () => {
        if (innerWidth === lastW2) return;
        lastW2 = innerWidth;
        requestAnimationFrame(place);
      });
    };
    fit();
    // Never leave the titles hidden for long, even if a font can't load.
    setTimeout(() => stack.classList.add('titles-ready'), 3000);

    // The photo marked `pan`: while you scroll through the extra room after it, it moves from its
    // top to its bottom (1px of photo per ~1.2px of scrolling), then the next photo comes up.
    const panel = stack.querySelector<HTMLElement>('[data-pan]');
    const img = panel?.querySelector<HTMLImageElement>('.media');
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (panel && img && !calm) {
      let extra = 0;
      const size = () => {
        const W = panel.clientWidth;
        const H = panel.clientHeight;
        const nw = img.naturalWidth;
        const nh = img.naturalHeight;
        if (!nw || !nh || !W || !H) return;
        const over = nh * Math.max(W / nw, H / nh) - H; // how much taller the photo is than the panel
        extra = over > 8 ? Math.round(over * 1.2) : 0;
        stack.style.setProperty('--extra', `${extra}px`);
        move();
      };
      // Where the panel would start if it weren't pinned (a pinned panel's own offsetTop moves with
      // the scroll): the room after it doesn't pin, so measure from there.
      const space = panel.nextElementSibling as HTMLElement;
      const move = () => {
        const start = stack.offsetTop + space.offsetTop - panel.offsetHeight;
        if (!extra) {
          img.style.objectPosition = ''; // nothing to scroll through (a phone): the usual framing
          return;
        }
        const t = Math.min(1, Math.max(0, (main.scrollTop - start) / extra));
        img.style.objectPosition = `50% ${(t * 100).toFixed(2)}%`;
      };
      let queued = false;
      main.addEventListener(
        'scroll',
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => ((queued = false), move()));
        },
        { passive: true },
      );
      if (img.complete) size();
      img.addEventListener('load', size);
      addEventListener('resize', () => requestAnimationFrame(size));
    }
  }
</script>

<style>
  .stackp {
    --area-h: calc(100svh - 100px); /* until the script measures it */
    --panel-h: calc(var(--area-h) * 0.92);
    --pad: 22px;
    --edge: 14px; /* the white strip between photos */
    --side: 24px; /* the white border down the sides */
    position: relative;
    isolation: isolate;
  }

  .panel {
    position: sticky;
    top: 0;
    z-index: var(--z);
    display: block;
    height: var(--panel-h);
    overflow: hidden;
    background: var(--ink);
    border-left: var(--side) solid var(--page);
    border-right: var(--side) solid var(--page);
  }

  /* A white strip above each photo: between one photo and the next, and under the header's line. */
  .panel {
    border-top: var(--edge) solid var(--page);
  }

  .panel :global(.media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }

  /* The extra scrolling room for the `pan` photo (set by the script; none until then). */
  .pan-space {
    height: var(--extra, 0px);
  }

  /* The `pan` photo fills the whole area under the header, so no empty room shows below it while
     you scroll through it. */
  .panel[data-pan] {
    height: var(--area-h);
  }

  /* A soft dark fade at the bottom, so the white title reads on any photo. */
  .panel:not(.light)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 16, 12, 0.4) 0%, rgba(20, 16, 12, 0) 50%);
    pointer-events: none;
  }

  /* The titles stay invisible until their font has loaded and they're spaced and placed (the script
     adds .titles-ready), so they never flash in a fallback font first. */
  .stackp:not(.titles-ready) .words {
    visibility: hidden;
  }

  /* The titles: one per photo, at the bottom of that photo's spot on the page, above all the photos. */
  .title {
    position: absolute;
    left: var(--side); /* the inside of the left border */
    right: 0;
    top: calc(var(--slot) * var(--panel-h));
    transform: translateY(-100%);
    /* (see .after-pan and .pan-title below) */
    z-index: 50;
    padding: 0; /* flush with the photo's bottom-left corner (the script nudges the ink into it) */
    color: #fff;
    text-decoration: none;
    pointer-events: none;
  }

  /* Titles of photos after the `pan` one sit lower by its extra room. */
  .title.after-pan {
    top: calc(var(--slot) * var(--panel-h) + var(--extra, 0px) + var(--area-h) - var(--panel-h));
  }

  /* The `pan` photo's title: its slot covers that photo's whole stretch of the page, and the title
     sticks to the bottom of the screen until the slot's end comes up, then scrolls up with it. */
  .pan-slot {
    position: absolute;
    top: 0;
    left: var(--side);
    right: 0;
    height: calc(var(--area-h) + var(--extra, 0px));
    z-index: 50;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
  }

  .title.pan-title {
    position: sticky;
    top: auto;
    bottom: 0;
    transform: none;
    padding-bottom: 0;
  }

  .title.dark {
    color: var(--ink);
  }

  a.title > * {
    pointer-events: auto;
  }

  .words {
    display: inline-block; /* only as wide as the word (a full-width box would poke out when squashed) */
    vertical-align: bottom;
    font-family: 'Rubik', var(--type);
    font-weight: 900;
    font-size: clamp(56px, 13vw, 210px);
    line-height: 0.88;
    letter-spacing: -0.05em; /* the letters just touch */
    white-space: nowrap;
  }

  .title.squat .words {
    font-family: 'Rubik Mono One', 'Rubik', var(--type);
    font-weight: 400;
    letter-spacing: -0.14em; /* the letters just touch */
    transform: scale(1.08, 0.78);
    transform-origin: left bottom;
  }

  .line {
    display: block;
  }

  /* Once the script has spaced each pair of letters itself (see fit()), no even spacing on top. */
  .title .words.fitted {
    letter-spacing: 0; /* (outranks the GÜSH title's own spacing too) */
    font-kerning: none;
  }

  .line + .line {
    text-align: right;
  }

  a.title:focus-visible {
    outline: none;
  }

  a.title:focus-visible .words {
    outline: 2px dashed currentColor;
    outline-offset: 6px;
  }

  @media (max-width: 699px) {
    .stackp {
      --panel-h: calc(var(--area-h) * 0.8);
      --pad: 14px;
      --edge: 10px;
      --side: 14px;
    }

    .panel :global(.media) {
      object-position: var(--pos-phone);
    }

    .words {
      font-size: 17vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      position: relative;
    }
  }
</style>
