---
// The about page's content: big photos that stack as you scroll, each with a big white title
// (StackPanels). Shown at /about and at the bare address, gush.supply (src/pages/index.astro), which
// stays as is in the address bar.
import StackPanels, { type Panel } from './StackPanels.astro';
import bag from '../assets/stack/bag-wide.webp';
import bagTall from '../assets/stack/shop.webp';
import thermalTag from '../assets/stack/tag.webp';
import plaid from '../assets/products/green-plaid-button-up/4.webp';
import scan from '../assets/scans/scan-2.jpg';

// The photos, in order. pos / posPhone: which part of the photo stays in view on computers / phones
// ("50% 100%" = the bottom). dark: a dark title, for a light photo. pan: scroll through the whole
// photo before the next one comes up. imgPhone: a different photo on phones.
const panels: Panel[] = [
  { img: bag, alt: 'a GÜSH tag on the drawstring bag, over yellow clogs in the fallen leaves', title: 'GÜSH', href: '/shop', posPhone: '50% 50%', pan: true, imgPhone: bagTall },
  { img: thermalTag, alt: 'the sewn GÜSH tag in the neck of the blue thermal', title: 'thermals', href: '/item/blue-thermal', pos: '50% 62%', posPhone: '57% 50%' },
  { img: plaid, alt: 'the GÜSH tag in the green plaid button up', title: 'shirts', href: '/item/green-plaid-button-up', pos: '50% 32%', posPhone: '55% 50%' },
  { img: scan, alt: 'the GÜSH lettering, machine sewn on white fabric', pos: '50% 30%', posPhone: '22% 50%', dark: true },
];
---

<StackPanels panels={panels} />
