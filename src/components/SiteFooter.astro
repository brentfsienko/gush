---
// The bottom of every page: the
// newsletter sign-up (worker/newsletter.ts), links to the info pages, and how to get in touch.
import { CONTACT_EMAIL } from '../data/store';

interface Props {
  /** Show the newsletter sign-up above the links (only the home and about pages do). */
  newsletter?: boolean;
}
const { newsletter = false } = Astro.props;

const links = [
  { href: '/contact', label: 'contact' },
  { href: '/returns', label: 'return & exchange policy' },
  { href: '/terms', label: 'terms' },
  { href: '/privacy', label: 'privacy policy' },
];
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <!-- The newsletter on its own: the pitch on the left, the sign-up on the right (web). -->
  {newsletter && (
  <section class="news" aria-labelledby="news-heading">
    <h2 class="foot-label" id="news-heading">newsletter</h2>
    <p class="news-pitch"><span>join the newsletter</span> <span>for updates on our latest</span> <span>styles and projects.</span></p>
    <form class="news-form" data-news novalidate>
      <div class="news-row">
        <input class="news-email" type="email" name="email" required maxlength="254" placeholder="email address" autocomplete="email" aria-label="email address" />
        <button class="news-btn" type="submit">sign up →</button>
      </div>
      <!-- Only bots fill this in (named so browsers never autofill it). -->
      <input class="hp" type="text" name="gush_trap" tabindex="-1" autocomplete="one-time-code" aria-hidden="true" data-1p-ignore data-lpignore="true" data-form-type="other" />
      <p class="news-note" data-news-note aria-live="polite"></p>
    </form>
  </section>
  )}

  <!-- Then a band of its own, a shade darker, with the links in columns. -->
  <div class="foot-band">
    <div class="foot-brand">
      <h2 class="foot-label">GÜSH</h2>
      <p>small batch clothing<br />made in Seattle</p>
      <p class="foot-fine">© {year} GÜSH</p>
    </div>
    <nav aria-labelledby="info-heading">
      <h2 class="foot-label" id="info-heading">quick links</h2>
      <ul class="foot-links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2 class="foot-label">contact</h2>
      <ul class="foot-links">
        <li><a href="/contact">get in touch</a></li>
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    margin-top: 24px;
  }

  .news,
  .foot-band {
    position: relative;
  }

  /* (No lines across: just white space between the parts.) */

  .news {
    padding: 34px var(--gutter) 40px;
  }

  .foot-label {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: normal;
    letter-spacing: 0.08em;
    color: var(--gray);
  }

  .news-pitch {
    margin: 0 0 22px;
    font-size: clamp(22px, 5.6vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* Three even lines, with "styles and projects." on its own. */
  .news-pitch span {
    display: block;
  }

  /* The field is just a line to write on; the button is a plain box. */
  .news-row {
    display: flex;
    align-items: flex-end;
    gap: 14px;
  }

  .news-email {
    flex: 1;
    min-width: 0;
    padding: 6px 0;
    font: inherit;
    font-size: 18px;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1.5px solid var(--ink);
    border-radius: 0;
  }

  .news-email::placeholder {
    color: var(--gray);
  }

  .news-email:focus {
    outline: none;
    border-bottom-width: 3px;
    padding-bottom: 4.5px;
  }

  .news-btn {
    flex-shrink: 0;
    padding: 8px 14px;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    background: var(--page);
    border: 1.5px solid var(--ink);
    border-radius: 0;
    cursor: pointer;
    white-space: nowrap;
  }

  .news-btn:hover,
  .news-btn:focus-visible {
    background: var(--ink);
    color: var(--page);
    outline: none;
  }

  .news-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .news-note {
    margin: 10px 0 0;
    font-size: 12px;
    color: var(--gray);
  }

  /* Empty until there's something to say ("you're on the list", or what went wrong). */
  .news-note:empty {
    margin: 0;
  }

  .news-note.error {
    color: var(--red);
  }

  .news-note.done {
    color: var(--ink);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* The band: a shade darker than the page, so it reads as the foot of the page. */
  .foot-band {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 24px;
    padding: 30px var(--gutter) calc(32px + env(safe-area-inset-bottom));
    background: rgba(31, 27, 22, 0.045);
    font-size: 14px;
  }

  .foot-brand {
    grid-column: 1 / -1;
  }

  .foot-brand p {
    margin: 0;
  }

  .foot-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .foot-links a {
    color: inherit;
    text-decoration: none;
  }

  .foot-links a:hover,
  .foot-links a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .foot-brand .foot-fine {
    margin-top: 14px;
    font-size: 12px;
    color: var(--gray);
  }

  /* Web: as on a catalog page. The pitch on the left, the sign-up on the right along its last line;
     then the band with three columns (GÜSH, quick links, contact) spread across. */
  @media (min-width: 900px) {
    .news {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'label label'
        'pitch form';
      column-gap: 64px;
      padding: 44px 32px 56px;
    }

    .news .foot-label {
      grid-area: label;
    }

    .news-pitch {
      grid-area: pitch;
      margin: 0;
      font-size: clamp(26px, 2.9vw, 46px);
    }

    .news-form {
      grid-area: form;
      align-self: end;
    }

    .news-email {
      font-size: 20px;
    }

    .foot-band {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 32px;
      padding: 36px 32px 44px;
    }

    .foot-brand {
      grid-column: auto;
    }
  }
</style>

<script>
  // Newsletter sign-up (worker/newsletter.ts).
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-news]')) {
    const email = form.querySelector<HTMLInputElement>('input[name=email]')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    const note = form.querySelector<HTMLElement>('[data-news-note]')!;
    const say = (text: string, kind: '' | 'error' | 'done' = '') => {
      note.textContent = text;
      note.className = `news-note ${kind}`.trim();
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const value = email.value.trim();
      if (!/^\S+@\S+\.\S+$/.test(value)) {
        say('that email doesn’t look right.', 'error');
        email.focus();
        return;
      }
      btn.disabled = true;
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: value, gush_trap: (form.elements.namedItem('gush_trap') as HTMLInputElement).value }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'something went wrong. try again?');
        say(data.already ? 'you’re already on the list ♥' : 'you’re on the list ♥ check your email.', 'done');
        email.value = '';
      } catch (err) {
        say(err instanceof Error && !(err instanceof TypeError) ? err.message : 'something went wrong. try again?', 'error');
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
