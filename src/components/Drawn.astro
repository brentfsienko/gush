---
// One of your drawings, shown at a fixed height (width follows the drawing's shape).
import { Image } from 'astro:assets';
import { drawn } from '../data/assets';

interface Props {
  name: string;
  /** Display height in CSS pixels. */
  h: number;
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { name, h, alt = '', class: cls, loading = 'lazy' } = Astro.props;
const img = drawn(name);
if (!img) throw new Error(`Missing drawing: put a file named "${name}.png" in src/assets/drawn/`);
---

<Image
  src={img}
  alt={alt}
  height={h}
  densities={[1, 2, 3]}
  format="webp"
  loading={loading}
  draggable="false"
  class:list={['drawn', cls]}
  style={`--h:${h}px`}
/>
