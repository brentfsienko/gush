---
// One of your drawings, shown at a fixed height (width follows the drawing's shape).
// The browser gets sharp copies for phone size (h) and, if given, computer size (webH),
// at 1x/2x/3x, so it never has to stretch a small copy. Saved at max quality so pen lines stay crisp.
//
// With `underline`, the word gets a line of real straight stitch under it (the same stitching as the line
// under the header). It shows on hover and on whatever is selected, and sews in stitch by stitch when it
// becomes selected (see "sewn underline" in global.css).
import { Image } from 'astro:assets';
import { drawn } from '../data/assets';

interface Props {
  name: string;
  /** Display height in CSS pixels on phones. */
  h: number;
  /** Display height on screens 700px and wider (defaults to h). */
  webH?: number;
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  underline?: boolean;
}

const { name, h, webH, alt = '', class: cls, loading = 'lazy', underline = false } = Astro.props;
const img = drawn(name);
if (!img) throw new Error(`Missing drawing: put a file named "${name}.png" in src/assets/drawn/`);

const aspect = img.width / img.height;
const cap = (w: number) => Math.min(Math.round(w), img.width);
const phoneW = h * aspect;
const webW = (webH ?? h) * aspect;
const widths = [...new Set([1, 2, 3].flatMap((d) => [cap(phoneW * d), cap(webW * d)]))].sort((a, b) => a - b);
const sizes = webH ? `(min-width: 700px) ${Math.round(webW)}px, ${Math.round(phoneW)}px` : `${Math.round(phoneW)}px`;
const style = `--h:${h}px;--h-web:${webH ?? h}px`;

// Every sewn piece has a margin of 24 scan pixels around the thread (room for its shadow); the
// underline runs under the thread itself.
const PAD = 24;
const STITCH = 7.4; // length of one machine stitch on screen (CSS px), for the sew-in animation
let lineStyle = '';
if (underline) {
  const wordW = ((img.width - 2 * PAD) * (webH ?? h)) / img.height;
  const inset = `${((PAD / img.width) * 100).toFixed(2)}%`;
  // each word starts at a different spot along the stitching, so no two underlines look the same
  const offset = [...name].reduce((n, c) => (n * 31 + c.charCodeAt(0)) % 997, 7) % 254;
  lineStyle = `left:${inset};right:${inset};--stitches:${Math.max(3, Math.round(wordW / STITCH))};--sew-x:-${offset}px`;
}
---

{
  underline ? (
    <span class:list={['sewn', cls]} style={style}>
      <Image
        src={img}
        alt={alt}
        height={h}
        widths={widths}
        sizes={sizes}
        format="webp"
        quality="max"
        loading={loading}
        draggable="false"
        class="drawn"
        style={style}
      />
      <span class="sew-line" style={lineStyle} aria-hidden="true" />
    </span>
  ) : (
    <Image
      src={img}
      alt={alt}
      height={h}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality="max"
      loading={loading}
      draggable="false"
      class:list={['drawn', cls]}
      style={style}
    />
  )
}
