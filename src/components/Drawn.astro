---
// One of your drawings, shown at a fixed height (width follows the drawing's shape).
// The browser gets sharp copies for phone size (h) and, if given, computer size (webH),
// at 1x/2x/3x, so it never has to stretch a small copy. Saved at max quality so pen lines stay crisp.
//
// With `underline`, the word gets its sewn underline (<name>-line: one long sewn box, exactly as wide as
// the word) under it. It shows on hover and on whatever is selected (see "sewn underline" in global.css).
import { Image } from 'astro:assets';
import { drawn } from '../data/assets';

interface Props {
  name: string;
  /** Display height in CSS pixels on phones. */
  h: number;
  /** Display height on screens 700px and wider (defaults to h). */
  webH?: number;
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  underline?: boolean;
}

const { name, h, webH, alt = '', class: cls, loading = 'lazy', underline = false } = Astro.props;
const img = drawn(name);
if (!img) throw new Error(`Missing drawing: put a file named "${name}.png" in src/assets/drawn/`);

const aspect = img.width / img.height;
const cap = (w: number) => Math.min(Math.round(w), img.width);
const phoneW = h * aspect;
const webW = (webH ?? h) * aspect;
const widths = [...new Set([1, 2, 3].flatMap((d) => [cap(phoneW * d), cap(webW * d)]))].sort((a, b) => a - b);
const sizes = webH ? `(min-width: 700px) ${Math.round(webW)}px, ${Math.round(phoneW)}px` : `${Math.round(phoneW)}px`;
const style = `--h:${h}px;--h-web:${webH ?? h}px`;

// The underline picture is the same width as the word's and drawn at the same scale, so it just spans
// the word; it sits so its thread starts a little below the word's thread.
const line = underline ? drawn(`${name}-line`) : undefined;
if (underline && !line) throw new Error(`Missing underline: "${name}-line.png" in src/assets/drawn/`);
const lineTop = line ? `${(((img.height - 26) / img.height) * 100).toFixed(2)}%` : '';
---

{
  underline ? (
    <span class:list={['sewn', cls]} style={style}>
      <Image
        src={img}
        alt={alt}
        height={h}
        widths={widths}
        sizes={sizes}
        format="webp"
        quality="max"
        loading={loading}
        draggable="false"
        class="drawn"
        style={style}
      />
      <Image
        src={line!}
        alt=""
        widths={widths.map((w) => Math.min(w, line!.width))}
        sizes={sizes}
        format="webp"
        quality="max"
        loading={loading}
        draggable="false"
        class="sew-line"
        style={`top:${lineTop}`}
        aria-hidden="true"
      />
    </span>
  ) : (
    <Image
      src={img}
      alt={alt}
      height={h}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality="max"
      loading={loading}
      draggable="false"
      class:list={['drawn', cls]}
      style={style}
    />
  )
}
