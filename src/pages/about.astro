---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { homePhotos } from '../data/assets';
import { ABOUT, SECOND_BLURB } from '../data/home';

const photo = homePhotos()[1] ?? homePhotos()[0];
---

<Base title="about" tab="about">
  <div class="stack about">
    <div class="type">
      <h2 class="heading">what is GÜSH?</h2>
      <p class="blurb">{ABOUT}</p>
    </div>

    {photo && <Image src={photo} alt="GÜSH blue thermal" widths={[480, 900]} sizes="(min-width: 480px) 360px, 75vw" class="photo polaroid" />}

    <div class="type">
      <p class="blurb">{SECOND_BLURB}</p>
    </div>
  </div>
</Base>

<style>
  .about {
    padding-top: 22px;
  }

  .blurb {
    margin: 12px 0 0;
  }

  .polaroid {
    width: 78%;
    margin: 0 auto;
  }
</style>
