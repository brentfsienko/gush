---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { homePhotos } from '../data/assets';
import { ABOUT, SECOND_BLURB } from '../data/home';

// Same photos as the home page (src/assets/home/): the first large, the rest side by side.
const [hero, ...rest] = homePhotos();
---

<Base title="about" tab="about">
  <div class="stack about">
    <div class="type">
      <h2 class="heading">what is GÜSH?</h2>
      <p class="blurb">{ABOUT}</p>
    </div>

    {hero && <Image src={hero} alt="GÜSH blue thermal" widths={[480, 900]} sizes="(min-width: 700px) 600px, 100vw" class="photo" />}

    {
      rest.length > 0 && (
        <div class="pair">
          {rest.map((src) => (
            <Image src={src} alt="GÜSH blue thermal" widths={[320, 640]} sizes="(min-width: 700px) 300px, 50vw" class="photo" />
          ))}
        </div>
      )
    }

    <div class="type">
      <p class="blurb">{SECOND_BLURB}</p>
    </div>
  </div>
</Base>

<style>
  .about {
    padding-top: 22px;
  }

  .blurb {
    margin: 12px 0 0;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    align-items: start;
  }

  .pair :global(.photo:nth-child(even)) {
    margin-top: 34px;
  }
</style>
