---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { homePhotos } from '../data/assets';
import { ABOUT, SECOND_BLURB } from '../data/home';
import { POLICIES, CONTACT_EMAIL } from '../data/store';

// Same photos as the home page (src/assets/home/), stacked full width.
const [hero, ...rest] = homePhotos();
---

<Base title="about" tab="about">
  <div class="stack about">
    <div class="type">
      <h2 class="heading">what is GÜSH?</h2>
      <p class="blurb">{ABOUT}</p>
    </div>

    {hero && <Image src={hero} alt="GÜSH clothing" widths={[480, 900]} sizes="(min-width: 700px) 600px, 100vw" class="photo" />}

    {
      rest.length > 0 && (
        <div class="photos">
          {rest.map((src) => (
            <Image src={src} alt="GÜSH clothing" widths={[480, 900, 1200]} sizes="(min-width: 700px) 600px, 100vw" class="photo" />
          ))}
        </div>
      )
    }

    {
      SECOND_BLURB && (
        <div class="type">
          <p class="blurb">{SECOND_BLURB}</p>
        </div>
      )
    }

    <section class="type info" id="info" aria-label="shipping, returns and contact">
      {
        POLICIES.map((p) => (
          <div>
            <h2 class="heading sub">{p.heading}</h2>
            <p class="blurb">
              {p.text}
              {p.heading === 'contact' && (
                <>
                  {' '}
                  <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
                </>
              )}
            </p>
          </div>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .about {
    padding-top: 22px;
  }

  .blurb {
    margin: 12px 0 0;
  }

  /* Shipping, returns & contact, below a thin rule. */
  .info {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 22px;
    border-top: 1px solid var(--ink);
  }

  .info .blurb {
    margin-top: 6px;
  }

  .info a {
    color: inherit;
  }

  .photos {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
</style>
