---
// The family Christmas gift list. Only opens through the secret link, /family/<key> (worker/family.ts
// checks the key and serves this page; anything else is "not found"). Settings: src/data/family.ts.
import Base from '../layouts/Base.astro';
import FamilyPickFields from '../components/FamilyPickFields.astro';
import { FAMILY_CODE, FAMILY_DEADLINE_LABEL, FAMILY_DELIVERY, FAMILY_STYLES } from '../data/family';
---

<Base title="family" footer={false} noindex>
  <article class="fam type">
    <!-- First thing they see: a wrapped present. Tapping it sets it on fire ("from the ashes of his
         software engineering crash and burn..."): it burns down to a pile of ash, and out of the ashes
         comes a burst of thread-and-fabric confetti. Then the page below fades in. -->
    <section class="gift" data-gift>
      <div class="stage" aria-hidden="true">
        <div class="present" data-present>
          <span class="bow bow-l"></span>
          <span class="bow bow-r"></span>
          <span class="lid"><span class="ribbon-v"></span></span>
          <span class="box"><span class="ribbon-v"></span></span>
        </div>
        <span class="ash" data-ash></span>
        <!-- Out of the ashes: the sewing machine (a Pfaff 1475 CD). A drawing for now; swap in a
             cut-out photo of the real one. -->
        <svg class="machine" data-machine viewBox="0 0 170 130" role="img" aria-label="a sewing machine">
          <line class="thread" x1="110" y1="14" x2="110" y2="6" />
          <path class="thread" d="M110 16 C 90 4, 50 6, 35 30" />
          <rect class="body" x="10" y="104" width="150" height="16" rx="3" />
          <rect class="body" x="118" y="30" width="30" height="76" rx="6" />
          <rect class="body" x="22" y="26" width="126" height="26" rx="10" />
          <rect class="body" x="16" y="26" width="36" height="52" rx="6" />
          <rect class="spool" x="104" y="12" width="12" height="14" rx="2" />
          <line class="ink" x1="34" y1="78" x2="34" y2="92" />
          <line class="ink needle" x1="34" y1="92" x2="34" y2="101" />
          <path class="ink" d="M26 100 h16" />
          <rect class="body" x="24" y="101" width="22" height="3" />
          <circle class="body" cx="152" cy="60" r="12" />
          <circle class="ink-fill" cx="152" cy="60" r="3.5" />
          <line class="ink" x1="60" y1="39" x2="110" y2="39" />
        </svg>
      </div>
      <p class="gift-from">a christmas surprise from GÜSH</p>
      <button class="btn gift-open" type="button" data-gift-open>tap to open</button>
    </section>

    <div class="reveal" data-reveal hidden>
    <p class="fam-label">GÜSH · family christmas</p>
    <h1 class="heading fam-title">pick your christmas gift</h1>
    <p class="intro" data-intro>
      from the ashes of his software engineering crash and burn, a seamstress was born. this christmas, the sewing
      prodigy based in Seattle, Brent, is opening up his unsustainably small apparel business, GÜSH, just for his
      family. if you are reading this, you are not on the naughty list and have the rare opportunity to select what
      kind of GÜSH gift you’d like to receive at christmas. if there’s any extra info you want to provide that would
      help with understanding your gift idea, please leave a note. love ya &lt;3
    </p>
    <p class="dim">one gift each · pick by {FAMILY_DEADLINE_LABEL}.</p>

    <div data-fam-body>
      <form class="fam-form" data-fam novalidate>
        <!-- 1. who -->
        <section class="step" data-step="1">
          <h2 class="heading step-title"><span class="step-num">1</span> who are you?</h2>
          <label class="field">
            <span>your name</span>
            <input type="text" name="name" maxlength="80" autocomplete="name" required />
          </label>
          <label class="field">
            <span>your email <span class="dim">(for updates on your gift)</span></span>
            <input type="email" name="email" maxlength="254" autocomplete="email" required />
          </label>
          <div class="nav"><button class="btn" type="button" data-next>next →</button></div>
        </section>

        <!-- 2. the gift -->
        <section class="step" data-step="2" hidden>
          <h2 class="heading step-title"><span class="step-num">2</span> pick your gift</h2>

          <FamilyPickFields />

          <div class="nav">
            <button class="btn ghost" type="button" data-back>← back</button>
            <button class="btn" type="button" data-next>next →</button>
          </div>
        </section>

        <!-- 3. the code -->
        <section class="step" data-step="3" hidden>
          <h2 class="heading step-title"><span class="step-num">3</span> your secret code</h2>
          <div class="code sewn-box" data-code-box>
            <span class="code-text">{FAMILY_CODE}</span>
            <span class="code-sub" data-code-sub>takes 100% off. it’s on us ♥</span>
          </div>
          <button class="btn" type="button" data-apply>use code {FAMILY_CODE}</button>

          <dl class="summary" data-summary></dl>

          <div class="nav">
            <button class="btn ghost" type="button" data-back>← back</button>
            <button class="btn" type="submit" data-submit disabled>send my pick</button>
          </div>
        </section>

      </form>

      <!-- done -->
      <section class="done" data-done hidden>
        <h2 class="heading" data-done-title>you’re on the list ♥</h2>
        <p data-done-text></p>
        <p><a data-done-link href="#">see your gift →</a></p>
      </section>

      <p class="msg" data-msg aria-live="polite"></p>
    </div>
    </div>
  </article>
</Base>

<style>
  .fam {
    max-width: 600px;
    margin: 0 auto;
    padding: 36px var(--gutter) 64px;
  }

  /* ---- the present ---- */
  .gift {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 56px 0 40px;
    text-align: center;
    transition: opacity 0.35s, transform 0.35s;
  }

  .stage {
    position: relative;
    margin-bottom: 6px;
  }

  .present {
    position: relative;
    width: 150px;
    height: 150px;
    cursor: pointer;
    animation: nudge 2.4s ease-in-out infinite;
  }

  .box,
  .lid {
    position: absolute;
    left: 50%;
    border: 2px solid var(--ink);
    background: var(--page);
    transform: translateX(-50%);
  }

  .box {
    bottom: 0;
    width: 124px;
    height: 96px;
  }

  /* the ribbon going around the box */
  .box::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 14px;
    margin-top: -7px;
    background: var(--red);
  }

  .lid {
    bottom: 94px;
    width: 140px;
    height: 26px;
    z-index: 1;
    transition: transform 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.3), opacity 0.55s;
  }

  .ribbon-v {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 16px;
    margin-left: -8px;
    background: var(--red);
  }

  .bow {
    position: absolute;
    bottom: 116px;
    left: 50%;
    width: 34px;
    height: 24px;
    border: 3px solid var(--red);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    z-index: 2;
    transition: transform 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.3), opacity 0.55s;
  }

  .bow-l {
    margin-left: -34px;
    transform: rotate(-24deg);
    transform-origin: right bottom;
  }

  .bow-r {
    transform: rotate(24deg);
    transform-origin: left bottom;
  }

  /* A little wiggle every few seconds, to say "tap me". */
  @keyframes nudge {
    0%, 80%, 100% { transform: rotate(0); }
    84% { transform: rotate(-4deg); }
    88% { transform: rotate(4deg); }
    92% { transform: rotate(-3deg); }
    96% { transform: rotate(2deg); }
  }

  /* Opening: a shake, then it burns down from the top (the script trims and darkens it as the
     flames go), leaving a pile of ash. */
  .present.opening {
    animation: shake 0.35s ease-in-out;
  }

  .present.burning {
    animation: none;
  }

  .ash {
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 116px;
    height: 20px;
    margin-left: -58px;
    border-radius: 50% 50% 10px 10px / 100% 100% 10px 10px;
    background:
      radial-gradient(circle at 22% 45%, #9a948c 0 2px, transparent 3px),
      radial-gradient(circle at 48% 30%, #5c5650 0 2.5px, transparent 3.5px),
      radial-gradient(circle at 70% 55%, #a8a29a 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 84% 70%, #4a4540 0 2px, transparent 3px),
      linear-gradient(#77716a, #3e3a35);
    box-shadow: 0 0 14px 2px rgba(255, 130, 40, 0.55);
    opacity: 0;
    transform: scaleY(0.2);
    transform-origin: bottom;
    transition: opacity 0.5s, transform 0.6s, box-shadow 1.6s;
  }

  /* The sewing machine, rising out of the ashes with a fiery glow. */
  .machine {
    position: absolute;
    left: 50%;
    bottom: 8px;
    width: 170px;
    margin-left: -85px;
    opacity: 0;
    transform: translateY(40px) scale(0.6);
    transform-origin: bottom center;
    pointer-events: none;
    overflow: visible;
  }

  .machine .body {
    fill: var(--page);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .machine .ink {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    fill: none;
  }

  .machine .needle {
    stroke-width: 1.2;
  }

  .machine .ink-fill {
    fill: var(--ink);
  }

  .machine .spool {
    fill: var(--red);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .machine .thread {
    stroke: var(--red);
    stroke-width: 1.3;
    fill: none;
  }

  .machine.rise {
    animation: phoenix 1.2s cubic-bezier(0.2, 0.9, 0.3, 1.15) forwards;
  }

  @keyframes phoenix {
    0% {
      opacity: 0;
      transform: translateY(40px) scale(0.6);
      filter: brightness(0.3) drop-shadow(0 0 0 rgba(255, 140, 40, 0));
    }
    40% {
      opacity: 1;
      filter: brightness(1.1) drop-shadow(0 0 18px rgba(255, 140, 40, 0.9));
    }
    100% {
      opacity: 1;
      transform: none;
      filter: drop-shadow(0 0 6px rgba(255, 140, 40, 0.3));
    }
  }

  .ash.on {
    opacity: 1;
    transform: none;
    box-shadow: 0 0 6px 0 rgba(255, 130, 40, 0.15);
  }

  .gift.burning .gift-from,
  .gift.burning .gift-open {
    opacity: 0;
    transition: opacity 0.4s;
  }

  @keyframes shake {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(-6deg) scale(1.03); }
    50% { transform: rotate(6deg) scale(1.05); }
    75% { transform: rotate(-4deg) scale(1.03); }
  }

  .gift-from {
    margin: 0;
    font-size: 19px;
  }

  .gift-open {
    font-size: 17px;
    padding: 11px 26px;
  }

  .gift.gone {
    opacity: 0;
    transform: scale(0.96);
  }

  /* The page, fading up into place once the present is open. */
  .reveal.in {
    animation: rise 0.6s ease-out both;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .present,
    .present.opening,
    .reveal.in {
      animation: none;
    }
  }

  /* Hidden parts stay hidden even where a layout style (flex) would show them. */
  [hidden] {
    display: none !important;
  }

  .fam-label {
    margin: 0 0 4px;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--gray);
  }

  .fam-title {
    margin: 0 0 14px;
    font-size: 30px;
  }

  .intro {
    margin: 0 0 12px;
    line-height: 1.65;
  }

  .dim {
    color: var(--gray);
  }

  .fam-form {
    margin-top: 28px;
  }

  .step-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-size: 21px;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    font-size: 15px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0 0 18px;
  }

  .field > span:first-child {
    font-size: 14px;
  }

  /* Lines to write on, like the rest of the site's forms. */
  input[type='text'],
  input[type='email'],
  textarea {
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1.5px solid var(--ink);
    border-radius: 0;
    padding: 6px 0;
  }

  textarea {
    border: 1.5px solid var(--ink);
    padding: 8px 10px;
    resize: vertical;
  }

  input[type='text']:focus,
  input[type='email']:focus,
  textarea:focus {
    outline: none;
    box-shadow: inset 0 -1.5px 0 var(--ink);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .btn {
    padding: 9px 18px;
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    background: var(--page);
    border: 1.5px solid var(--ink);
    border-radius: 0;
    cursor: pointer;
  }

  .btn:hover:not(:disabled),
  .btn:focus-visible {
    background: var(--ink);
    color: var(--page);
    outline: none;
  }

  .btn.ghost {
    border-style: dashed;
  }

  .btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* The code, in a sewn box (the same stitch as the header line). */
  .code {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: 0 0 16px;
    padding: 26px 16px;
    text-align: center;
  }

  .code-text {
    font-size: clamp(30px, 9vw, 44px);
    letter-spacing: 0.12em;
  }

  .code-sub {
    font-size: 14px;
    color: var(--gray);
  }

  .code.used .code-text {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    color: var(--gray);
  }

  .code.used .code-sub {
    color: var(--ink);
  }

  .summary {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 22px 0 18px;
    font-size: 15px;
  }

  .summary :global(dt) {
    color: var(--gray);
  }

  .summary :global(dd) {
    margin: 0;
  }

  .msg {
    min-height: 1.5em;
    margin-top: 14px;
    color: var(--red);
  }

  .done {
    margin-top: 28px;
  }

  .done a {
    color: inherit;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
</style>

<script>
  // Confetti: little thread snippets, fabric scraps and stitches in the gift colors, thrown from a
  // point on the screen (x, y as fractions of it). Skipped for people who've turned off animations.
  const COLORS = ['#c8372d', '#2f5d9e', '#e8c547', '#2f6b45', '#6b4a9e', '#e9a3b8', '#e07b2e', '#1f1b16'];
  const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** A see-through canvas over the whole screen, for the confetti and the fire. */
  function overlay() {
    const canvas = document.createElement('canvas');
    canvas.setAttribute('aria-hidden', 'true');
    canvas.style.cssText = 'position:fixed;inset:0;width:100vw;height:100dvh;pointer-events:none;z-index:50';
    document.body.append(canvas);
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const w = innerWidth;
    const h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    return { canvas, ctx, w, h };
  }

  function confetti(x = 0.5, y = 0.4, count = 150) {
    if (still()) return;
    const { canvas, ctx, w, h } = overlay();
    const kinds = ['thread', 'thread', 'scrap', 'stitch'] as const;
    const bits = Array.from({ length: count }, () => {
      const angle = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.1;
      const speed = 7 + Math.random() * 9;
      return {
        x: x * w,
        y: y * h,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        rot: Math.random() * Math.PI,
        spin: (Math.random() - 0.5) * 0.3,
        size: 6 + Math.random() * 8,
        color: COLORS[Math.floor(Math.random() * COLORS.length)],
        kind: kinds[Math.floor(Math.random() * kinds.length)],
        wobble: Math.random() * 10,
      };
    });
    const start = performance.now();
    const frame = (t: number) => {
      const age = (t - start) / 1000;
      ctx.clearRect(0, 0, w, h);
      ctx.globalAlpha = Math.max(0, 1 - Math.max(0, age - 2.2) / 0.8);
      for (const b of bits) {
        b.vy += 0.32;
        b.vx *= 0.985;
        b.vy *= 0.985;
        b.x += b.vx + Math.sin(age * 6 + b.wobble) * 0.6;
        b.y += b.vy;
        b.rot += b.spin;
        ctx.save();
        ctx.translate(b.x, b.y);
        ctx.rotate(b.rot);
        ctx.strokeStyle = b.color;
        ctx.fillStyle = b.color;
        ctx.lineCap = 'round';
        if (b.kind === 'thread') {
          // a curly bit of thread
          ctx.lineWidth = 1.6;
          ctx.setLineDash([]);
          ctx.beginPath();
          ctx.moveTo(-b.size, 0);
          ctx.quadraticCurveTo(-b.size / 3, -b.size / 2, 0, 0);
          ctx.quadraticCurveTo(b.size / 3, b.size / 2, b.size, 0);
          ctx.stroke();
        } else if (b.kind === 'scrap') {
          // a little square of fabric
          ctx.fillRect(-b.size / 2, -b.size / 3, b.size, b.size * 0.66);
        } else {
          // a few stitches
          ctx.lineWidth = 2;
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.moveTo(-b.size, 0);
          ctx.lineTo(b.size, 0);
          ctx.stroke();
        }
        ctx.restore();
      }
      if (age < 3) requestAnimationFrame(frame);
      else canvas.remove();
    };
    requestAnimationFrame(frame);
  }
  // For the "you're on the list" burst in the form script below.
  (window as unknown as { gushConfetti: typeof confetti }).gushConfetti = confetti;

  /** Burns an element down from the top over `ms`: flames along the burning edge, smoke, then embers
   *  rising from the ash. Calls onAsh once it's gone. */
  function burn(el: HTMLElement, ms: number, onAsh: () => void) {
    const r = el.getBoundingClientRect();
    const { canvas, ctx, w, h } = overlay();
    type Bit = { kind: 'flame' | 'smoke' | 'ember'; x: number; y: number; vx: number; vy: number; life: number; max: number; size: number };
    const bits: Bit[] = [];
    let ashed = false;
    const start = performance.now();
    const frame = (t: number) => {
      const age = t - start;
      const p = Math.min(1, age / ms);
      const burnt = p * p * (3 - 2 * p);
      el.style.clipPath = `inset(${(burnt * 100).toFixed(2)}% 0 0 0)`;
      el.style.filter = `brightness(${(1 - 0.8 * burnt).toFixed(3)}) sepia(${burnt.toFixed(3)})`;
      const edge = r.top + burnt * r.height;
      if (p < 1) {
        for (let i = 0; i < 7; i++) {
          bits.push({ kind: 'flame', x: r.left + 14 + Math.random() * (r.width - 28), y: edge + Math.random() * 6, vx: (Math.random() - 0.5) * 0.8, vy: -(1.2 + Math.random() * 2.2), life: 0, max: 28 + Math.random() * 24, size: 7 + Math.random() * 9 });
        }
        if (Math.random() < 0.5) {
          bits.push({ kind: 'smoke', x: r.left + r.width / 2 + (Math.random() - 0.5) * r.width * 0.6, y: edge - 10, vx: (Math.random() - 0.5) * 0.6, vy: -(0.8 + Math.random()), life: 0, max: 70 + Math.random() * 40, size: 10 + Math.random() * 10 });
        }
      } else if (!ashed) {
        ashed = true;
        onAsh();
      }
      if (p >= 1 && age < ms + 900 && Math.random() < 0.35) {
        bits.push({ kind: 'ember', x: r.left + r.width / 2 + (Math.random() - 0.5) * 90, y: r.bottom - 8, vx: (Math.random() - 0.5) * 0.5, vy: -(0.6 + Math.random() * 1.2), life: 0, max: 50 + Math.random() * 30, size: 1.5 + Math.random() * 1.5 });
      }
      ctx.clearRect(0, 0, w, h);
      for (let i = bits.length - 1; i >= 0; i--) {
        const b = bits[i];
        if (++b.life > b.max) {
          bits.splice(i, 1);
          continue;
        }
        b.x += b.vx + Math.sin((b.life + i) * 0.3) * 0.4;
        b.y += b.vy;
        const f = b.life / b.max;
        ctx.beginPath();
        if (b.kind === 'flame') {
          // yellow at the base, then orange, red, and dark as it rises and dies
          const size = b.size * (1 - f * 0.8);
          ctx.globalAlpha = (1 - f) * 0.9;
          ctx.fillStyle = f < 0.25 ? '#ffd23f' : f < 0.55 ? '#ff8a1f' : f < 0.8 ? '#e0452a' : '#5a514a';
          ctx.ellipse(b.x, b.y, size * 0.6, size, 0, 0, Math.PI * 2);
        } else if (b.kind === 'smoke') {
          ctx.globalAlpha = (1 - f) * 0.18;
          ctx.fillStyle = '#4a4540';
          ctx.arc(b.x, b.y, b.size * (1 + f * 1.5), 0, Math.PI * 2);
        } else {
          ctx.globalAlpha = 1 - f;
          ctx.fillStyle = f < 0.5 ? '#ffb347' : '#e0452a';
          ctx.arc(b.x, b.y, b.size, 0, Math.PI * 2);
        }
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (age < ms + 1000 || bits.length) requestAnimationFrame(frame);
      else canvas.remove();
    };
    requestAnimationFrame(frame);
  }

  // The present: tap it (or the button) to open.
  const gift = document.querySelector<HTMLElement>('[data-gift]');
  const reveal = document.querySelector<HTMLElement>('[data-reveal]');
  const present = document.querySelector<HTMLElement>('[data-present]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-gift-open]');
  const ash = document.querySelector<HTMLElement>('[data-ash]');
  const machine = document.querySelector<SVGElement | HTMLElement>('[data-machine]');
  if (gift && reveal && present && openBtn && ash && machine) {
    const showPage = () => {
      gift.hidden = true;
      reveal.hidden = false;
      reveal.classList.add('in');
    };
    let opened = false;
    const open = () => {
      if (opened) return;
      opened = true;
      openBtn.disabled = true;
      if (still()) return showPage();
      // A shake, then it goes up in flames, burns down to ash, and confetti bursts out of the ashes.
      gift.classList.add('burning');
      present.classList.add('opening');
      setTimeout(() => {
        present.classList.remove('opening');
        present.classList.add('burning');
        burn(present, 1500, () => {
          ash.classList.add('on');
          // Out of the ashes: the sewing machine rises, and the confetti bursts around it.
          setTimeout(() => {
            machine.classList.add('rise');
            const r = ash.getBoundingClientRect();
            confetti((r.left + r.width / 2) / innerWidth, r.top / innerHeight);
          }, 300);
          setTimeout(() => gift.classList.add('gone'), 2300);
          setTimeout(showPage, 2650);
        });
      }, 350);
    };
    openBtn.addEventListener('click', open);
    present.addEventListener('click', open);
  }
</script>

<script define:vars={{ FAMILY_CODE, FAMILY_DELIVERY, STYLES: FAMILY_STYLES }}>
  const form = document.querySelector('[data-fam]');
  if (form) {
    const key = location.pathname.split('/')[2] || '';
    const msg = document.querySelector('[data-msg]');
    const steps = [...form.querySelectorAll('[data-step]')];
    const say = (t) => (msg.textContent = t);
    const val = (n) => {
      const el = form.elements.namedItem(n);
      if (!el) return '';
      if (el instanceof RadioNodeList) return el.value;
      return el.value.trim();
    };
    let applied = false;

    const intro = document.querySelector('[data-intro]');
    const show = (n) => {
      steps.forEach((s) => (s.hidden = s.dataset.step !== String(n)));
      // Brent's note is just for the first page.
      intro.hidden = n !== 1;
      say('');
      window.scrollTo({ top: 0 });
      document.querySelector('main')?.scrollTo({ top: 0 });
      if (n === 3) renderSummary();
    };

    const check = (n) => {
      if (n === 1) {
        if (!val('name')) return 'tell us your name.';
        if (!/^\S+@\S+\.\S+$/.test(val('email'))) return 'that email doesn’t look right.';
      }
      if (n === 2) {
        const style = val('style');
        if (!style) return 'pick a gift.';
        if (!val('color') && style !== 'mystery') return 'pick a color.';
        if (style === 'bag' ? !val('bag') : !val('size')) return style === 'bag' ? 'tell us what kind of bag.' : 'pick a size.';
      }
      return '';
    };

    // The end screen: their new pick, or (already picked) what they picked before.
    const finish = (data) => {
      if (!data.already) window.gushConfetti?.(0.5, 0.25, 70);
      form.hidden = true;
      intro.hidden = true;
      const done = document.querySelector('[data-done]');
      done.querySelector('[data-done-title]').textContent = data.already ? 'you already picked your gift ♥' : 'you’re on the list ♥';
      const link = done.querySelector('[data-done-link]');
      if (data.already && data.editable) {
        // Already picked, not sewn yet: send them to change it.
        done.querySelector('[data-done-text]').textContent = `${data.label}. want to change it?`;
        link.textContent = 'change my pick →';
        link.href = `${data.trackUrl}/edit`;
      } else {
        done.querySelector('[data-done-text]').textContent = data.already
          ? `${data.label}. it’s already on the machine, so it’s locked in ♥`
          : `${data.label}. it’ll be sewn by hand and given to you at christmas. we just emailed you a link to check on it (you can change your pick there until it’s on the machine).`;
        link.textContent = 'see your gift →';
        link.href = data.trackUrl;
      }
      done.hidden = false;
      window.scrollTo({ top: 0 });
      document.querySelector('main')?.scrollTo({ top: 0 });
    };

    form.querySelectorAll('[data-next]').forEach((b) =>
      b.addEventListener('click', async () => {
        const n = Number(b.closest('[data-step]').dataset.step);
        const problem = check(n);
        if (problem) return say(problem);
        // Step 1: one gift per person. Stop here if this email or name already picked.
        if (n === 1) {
          b.disabled = true;
          try {
            const res = await fetch('/api/family/check', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ key, name: val('name'), email: val('email') }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || 'something went wrong. try again?');
            if (data.already && data.trackUrl) return finish(data);
          } catch (err) {
            return say(err instanceof Error && !(err instanceof TypeError) ? err.message : 'something went wrong. try again?');
          } finally {
            b.disabled = false;
          }
        }
        show(n + 1);
      }),
    );
    form.querySelectorAll('[data-back]').forEach((b) =>
      b.addEventListener('click', () => show(Number(b.closest('[data-step]').dataset.step) - 1)),
    );

    const giftLabel = () => {
      const style = val('style');
      const label = STYLES.find((s) => s.key === style)?.label ?? '';
      const color = val('color');
      if (style === 'mystery') return color && color !== 'surprise' ? `mystery gift (${color})` : 'mystery gift';
      if (style === 'bag') return `${color} bag · ${val('bag').toLowerCase()}`;
      return `${color} ${label}`;
    };

    const summary = form.querySelector('[data-summary]');
    function renderSummary() {
      const rows = [
        ['for', val('name')],
        ['gift', giftLabel()],
        val('style') === 'bag' ? null : ['size', val('size').toUpperCase()],
        val('fit') ? ['note', val('fit')] : null,
        ['delivery', FAMILY_DELIVERY],
        applied ? ['code', `${FAMILY_CODE} · 100% off ♥`] : null,
      ].filter(Boolean);
      summary.replaceChildren(
        ...rows.flatMap(([k, v]) => {
          const dt = document.createElement('dt');
          dt.textContent = k;
          const dd = document.createElement('dd');
          dd.textContent = v;
          return [dt, dd];
        }),
      );
    }

    const apply = form.querySelector('[data-apply]');
    const submit = form.querySelector('[data-submit]');
    apply.addEventListener('click', () => {
      applied = true;
      form.querySelector('[data-code-box]').classList.add('used');
      form.querySelector('[data-code-sub]').textContent = 'applied: 100% off ♥';
      apply.hidden = true;
      submit.disabled = false;
      renderSummary();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!applied) return say('use your secret code first.');
      submit.disabled = true;
      say('');
      try {
        const res = await fetch('/api/family', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            key,
            name: val('name'),
            email: val('email'),
            style: val('style'),
            color: val('color'),
            size: val('size'),
            bag: val('bag'),
            fit: val('fit'),
            code: FAMILY_CODE,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'something went wrong. try again?');
        // Only show "you're on the list" once the pick is really saved (it comes back with its link).
        if (!data.trackUrl || !data.label) throw new Error('hmm, your pick didn’t save. give it another try?');
        finish(data);
      } catch (err) {
        say(err instanceof Error && !(err instanceof TypeError) ? err.message : 'something went wrong. try again?');
        submit.disabled = false;
      }
    });
  }
</script>
