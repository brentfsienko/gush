---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Drawn from '../components/Drawn.astro';
import Label from '../components/Label.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CATEGORIES, PRODUCTS, formatPrice } from '../data/products';
import { productPhotos, drawn } from '../data/assets';

// Filters whose drawing exists (a new category shows up once its filter-<name>.png is added).
const filters = CATEGORIES.filter((c) => drawn(`filter-${c}`));

---

<Base title="shop" tab="shop" fill>
  <nav class="crumbs" aria-label="breadcrumb">
    <a href="/home">home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a href="/shop" aria-current="page">shop</a>
  </nav>

  <nav class="filters" aria-label="categories">
    {
      filters.map((c) => (
        <button class="drawn-btn filter" data-filter={c} aria-pressed={c === 'all' ? 'true' : 'false'} aria-label={c}>
          <Label text={c} size={18} webSize={21} underline />
        </button>
      ))
    }
  </nav>

  <div class="feed" data-feed>
    {
      PRODUCTS.map((p, i) => {
        const [first] = productPhotos(p.slug);
        return (
          <article class="feed-item" data-category={p.category}>
            <a href={`/item/${p.slug}`} class="card">
              <div class="card-photos">
                {first && (
                  <Image src={first} alt={p.title} widths={[480, 900]} sizes="(min-width: 480px) 400px, 85vw" class="photo main-photo" loading={i < 2 ? 'eager' : 'lazy'} />
                )}
              </div>
              <div class="card-meta">
                <h2 class="heading card-name">{p.title}</h2>
                <p class="price card-price">{formatPrice(p.price)}</p>
              </div>
            </a>
          </article>
        );
      })
    }

    <article class="feed-item" data-empty hidden>
      <div class="note">
        <h2 class="heading">nothing here yet</h2>
        <p>check back soon.</p>
      </div>
    </article>

    <!-- Built like an item card (square photo area + name/price lines) so it's exactly item-sized. -->
    <article class="feed-item" data-end>
      <div class="card soon">
        <div class="card-photos soon-box">
          <h2 class="heading">more coming soon</h2>
        </div>
        <div class="card-meta" aria-hidden="true">
          <span class="heading card-name">&nbsp;</span>
          <span class="price card-price">&nbsp;</span>
        </div>
      </div>
    </article>

    <!-- The footer, as the last stop in the feed (the full width under the grid on web). -->
    <div class="feed-foot">
      <SiteFooter />
    </div>
  </div>
</Base>

<style>
  .filters {
    width: 100%;
    max-width: var(--column);
    margin-inline: auto;
    display: flex;
    gap: 10px;
    padding: 32px var(--gutter) 10px;
    overflow-x: auto;
    scrollbar-width: none;
    flex-shrink: 0;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  /* Web: the category row and the item grid share one centered column (sizes in global.css, shared
     with the breadcrumbs), so they all line up with the left edge of the first item. Each item column
     is capped by the screen height so a whole item (photo, name, price) fits on screen. */
  @media (min-width: 700px) {
    .filters,
    .feed {
      --gap: var(--grid-gap);
      --col: var(--grid-col);
      padding-left: var(--grid-side);
      padding-right: var(--grid-side);
    }

    .filters {
      max-width: none;
    }
  }


  .filter {
    flex-shrink: 0;
  }

  /* TikTok-style: one card per screen, snaps into place. */
  /* The feed is the shop's scrolling area, so it carries the fabric (scrolling with the items). Its
     pattern is shifted up by its distance from the top of the page (--feed-top, set below) so it
     continues seamlessly from the fabric above it. */
  .feed {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    background: var(--fabric);
    background-attachment: local;
    background-position: 0 calc(-1 * var(--feed-top, 0px));
    scroll-snap-type: y mandatory;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .feed::-webkit-scrollbar {
    display: none;
  }

  /* Phones: the feed only moves up and down. Nothing slides sideways (the card outline reaches a few
     px past the screen edge, which would otherwise make the feed scrollable left and right). */
  @media (max-width: 699px) {
    .feed {
      overflow-x: hidden;
      overscroll-behavior-x: none;
      touch-action: pan-y;
    }

    .feed-item {
      overflow-x: clip;
    }
  }

  /* Phones: one item per screen, spanning the full width (the name/price keep a small gutter). */
  .feed-item {
    height: 100%;
    padding: 10px 0 16px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
  }

  .feed-item[hidden] {
    display: none;
  }

  .feed-foot {
    scroll-snap-align: end;
  }

  @media (min-width: 700px) {
    .feed-foot {
      grid-column: 1 / -1;
      margin-inline: calc(-1 * var(--grid-side));
    }
  }

  .card {
    color: inherit;
    text-decoration: none;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    /* The whole item (photo, name, price) is one block. On hover a thin black line (like the one
       under the header) outlines it. */
    position: relative;
    padding: 0 0 12px;
  }

  /* The outline: top and bottom on ::before, the sides on ::after. Each line is 7px tall with the
     thread along its middle, and every side stops at the middle of the sides it meets, so the
     corners meet without crossing. */
  .card::before,
  .card::after {
    content: '';
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }

  .card::before {
    inset: -2.5px;
    border: 1.5px solid var(--ink);
  }

  .card::after {
    display: none;
  }

  @media (hover: hover) {
    a.card:hover::before,
    a.card:hover::after {
      opacity: 1;
    }
  }

  a.card:active::before,
  a.card:active::after {
    opacity: 1;
  }

  .card-photos {
    flex: 1;
    min-height: 0;
  }

  /* The same margin inside every card, so each garment sits centered with even space around it,
     however close its photo is cropped. */
  .main-photo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 7%;
  }

  /* Name with the price right under it, a touch smaller than headings; price in gray. */
  .card-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 0 var(--gutter);
  }

  .card-name,
  .card-price {
    font-size: calc(22px * 0.92);
  }

  .card-price {
    color: var(--gray);
  }

  .note {
    margin: auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 40px;
  }

  .soon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* Its own card: on hover, outlined like an item card, --in from its edges. */
    --in: var(--gutter);
    position: relative;
  }

  .soon-box::before,
  .soon-box::after {
    content: '';
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }

  @media (hover: hover) {
    .soon:hover .soon-box::before,
    .soon:hover .soon-box::after {
      opacity: 1;
    }
  }

  .soon:active .soon-box::before,
  .soon:active .soon-box::after {
    opacity: 1;
  }

  .soon-box::before {
    inset: var(--in);
    border: 1.5px solid var(--ink);
  }

  .soon-box::after {
    display: none;
  }

  @media (min-width: 700px) {
    .soon-box {
      --in: 0px;
    }
  }

  .note p {
    margin: 10px 0 0;
  }

  /* Web: products two across in a grid with normal scrolling (phones keep one full-screen item at a
     time). "More coming soon" fills the next spot (under the first item) as a box the same size as an item. */
  @media (min-width: 700px) {
    .feed {
      display: grid;
      grid-template-columns: repeat(2, var(--col));
      align-content: start;
      gap: var(--gap);
      padding-top: 18px;
      padding-bottom: 48px;
      scroll-snap-type: none;
    }

    .feed-item {
      height: auto;
      max-width: none;
      margin: 0;
      padding: 0;
      scroll-snap-align: none;
    }

    .card {
      padding: 12px;
    }

    .card-meta {
      padding: 0;
    }

    .card-photos {
      flex: none;
      aspect-ratio: 1 / 1;
    }

    /* "More coming soon" (a .card too) lifts like an item; the old note box hover is unused here. */
    .note {
      flex: 1;
      margin: 0;
      justify-content: center;
    }


  }

</style>

<script>
  // Line the feed's fabric up with the fabric above it (see .feed in the styles).
  const feedEl = document.querySelector<HTMLElement>('[data-feed]')!;
  const alignFabric = () => feedEl.style.setProperty('--feed-top', `${feedEl.offsetTop}px`);
  alignFabric();
  addEventListener('resize', alignFabric);

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const feed = document.querySelector<HTMLElement>('[data-feed]')!;
  const items = [...feed.querySelectorAll<HTMLElement>('[data-category]')];
  const empty = feed.querySelector<HTMLElement>('[data-empty]')!;
  const end = feed.querySelector<HTMLElement>('[data-end]')!;

  function apply(filter: string, push: boolean) {
    if (!buttons.some((b) => b.dataset.filter === filter)) filter = 'all';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    let shown = 0;
    for (const item of items) {
      item.hidden = filter !== 'all' && item.dataset.category !== filter;
      if (!item.hidden) shown++;
    }
    empty.hidden = shown > 0;
    end.hidden = shown === 0;
    feed.scrollTop = 0;
    if (push) {
      const url = new URL(location.href);
      if (filter === 'all') url.searchParams.delete('c');
      else url.searchParams.set('c', filter);
      history.replaceState(null, '', url);
    }
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!, true)));
  apply(new URL(location.href).searchParams.get('c') ?? 'all', false);
</script>
