---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DrawnToggle from '../components/DrawnToggle.astro';
import { CATEGORIES, PRODUCTS, formatPrice } from '../data/products';
import { productPhotos } from '../data/assets';

---

<Base title="shop" tab="shop" fill>
  <nav class="filters" aria-label="categories">
    {
      CATEGORIES.map((c) => (
        <button class="drawn-btn filter" data-filter={c} aria-pressed={c === 'all' ? 'true' : 'false'} aria-label={c}>
          <DrawnToggle name={`filter-${c}`} h={46} webH={52} />
        </button>
      ))
    }
  </nav>

  <div class="feed" data-feed>
    {
      PRODUCTS.map((p, i) => {
        const [first, second] = productPhotos(p.slug);
        return (
          <article class="feed-item" data-category={p.category}>
            <a href={`/item/${p.slug}`} class="card">
              <div class="card-photos">
                {first && (
                  <Image src={first} alt={p.title} widths={[480, 900]} sizes="(min-width: 480px) 400px, 85vw" class="photo main-photo" loading={i < 2 ? 'eager' : 'lazy'} />
                )}
                {second && <Image src={second} alt="" widths={[240, 480]} sizes="40vw" class="photo second-photo" />}
              </div>
              <div class="card-meta">
                <h2 class="heading">{p.title}</h2>
                <p class="price">{formatPrice(p.price)}</p>
              </div>
            </a>
          </article>
        );
      })
    }

    <article class="feed-item" data-empty hidden>
      <div class="note">
        <h2 class="heading">nothing here yet</h2>
        <p>check back soon.</p>
      </div>
    </article>

    <article class="feed-item" data-end>
      <div class="note">
        <h2 class="heading">more coming soon</h2>
      </div>
    </article>
  </div>
</Base>

<style>
  .filters {
    width: 100%;
    max-width: var(--column);
    margin-inline: auto;
    display: flex;
    gap: 10px;
    padding: 16px var(--gutter) 10px;
    overflow-x: auto;
    scrollbar-width: none;
    flex-shrink: 0;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  /* Web: categories sit on the left of the page, lined up under the SHOP tab. */
  @media (min-width: 700px) {
    .filters {
      max-width: none;
      padding-left: 32px;
    }
  }

  /* Wide screens: stacked down the left side like a sub-menu of SHOP, out of the product column's way. */
  @media (min-width: 1000px) {
    /* Full-height column with a vertical line separating it from the products. */
    .filters {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 28px 28px 0 32px;
      border-right: 1.5px solid var(--ink);
      overflow: visible;
      z-index: 1;
    }
  }

  .filter {
    flex-shrink: 0;
  }

  /* TikTok-style: one card per screen, snaps into place. */
  .feed {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .feed::-webkit-scrollbar {
    display: none;
  }

  .feed-item {
    height: 100%;
    max-width: var(--column);
    margin-inline: auto;
    padding: 14px var(--gutter) 18px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
  }

  .feed-item[hidden] {
    display: none;
  }

  .card {
    color: inherit;
    text-decoration: none;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-photos {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .main-photo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .second-photo {
    position: absolute;
    right: 3%;
    bottom: 3%;
    width: 40%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .note {
    margin: auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 40px;
  }

  .note p {
    margin: 10px 0 0;
  }
</style>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const feed = document.querySelector<HTMLElement>('[data-feed]')!;
  const items = [...feed.querySelectorAll<HTMLElement>('[data-category]')];
  const empty = feed.querySelector<HTMLElement>('[data-empty]')!;
  const end = feed.querySelector<HTMLElement>('[data-end]')!;

  function apply(filter: string, push: boolean) {
    if (!buttons.some((b) => b.dataset.filter === filter)) filter = 'all';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    let shown = 0;
    for (const item of items) {
      item.hidden = filter !== 'all' && item.dataset.category !== filter;
      if (!item.hidden) shown++;
    }
    empty.hidden = shown > 0;
    end.hidden = shown === 0;
    feed.scrollTop = 0;
    if (push) {
      const url = new URL(location.href);
      if (filter === 'all') url.searchParams.delete('c');
      else url.searchParams.set('c', filter);
      history.replaceState(null, '', url);
    }
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!, true)));
  apply(new URL(location.href).searchParams.get('c') ?? 'all', false);
</script>
