---
import Base from '../layouts/Base.astro';
import Drawn from '../components/Drawn.astro';
---

<Base title="not found">
  <div class="stack">
    <div class="type lost">
      <h2 class="heading">nothing here</h2>
      <p>this page got torn out.</p>
      <a href="/shop" aria-label="keep shopping"><Drawn name="btn-keep-shopping" h={48} /></a>
    </div>
  </div>
</Base>

<style>
  .lost {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
    padding-block: 44px;
  }

  .lost p {
    margin: 0;
  }
</style>
