---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Drawn from '../../components/Drawn.astro';
import { PRODUCTS, SIZES, formatPrice, type Product } from '../../data/products';
import { productPhotos } from '../../data/assets';
import { TAGLINE } from '../../data/store';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props as { product: Product };
const photos = productPhotos(p.slug);
// Full-size copies for the zoom view (as sharp as the original photo allows).
const zoomUrls = await Promise.all(
  photos.map(async (src) => (await getImage({ src, width: Math.min(src.width, 2400), format: 'webp', quality: 'max' })).src),
);
const sizes = SIZES.filter((s) => p.stock[s] !== undefined);
const soldOut = sizes.every((s) => (p.stock[s] ?? 0) <= 0);
// Shown above the email box when every size is sold out (worker/live-stock-page.ts uses the same words).
const ALL_SOLD_NOTE = 'sold out. pick your size and leave your email, and we’ll let you know when it’s back.';
---

<Base title={p.title} tab="shop" description={`${p.title} · ${TAGLINE}`} image={productPhotos(p.slug).length ? `/og/${p.slug}.png` : undefined}>
  <nav class="crumbs item-crumbs" aria-label="breadcrumb">
    <a href="/home">home</a>
    <span aria-hidden="true">›</span>
    <a href="/shop">shop</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">{p.title}</span>
  </nav>

  <div class="item-layout">
  <div class="item-media">
  <a href="/shop" class="back" aria-label="back to shop" data-back>
    <Drawn name="btn-back" h={34} webH={44} underline />
  </a>

  <div class="gallery" data-gallery>
    {
      photos.map((src, i) => (
        <Image src={src} alt={`${p.title}, photo ${i + 1}`} widths={[400, 800, 1200]} sizes="(min-width: 900px) 560px, 100vw" class:list={['slide', { fill: src.width / src.height > 1.6 }]} loading={i === 0 ? 'eager' : 'lazy'} data-zoom={zoomUrls[i]} />
      ))
    }
  </div>
  {
    photos.length > 1 && (
      <div class="gallery-nav">
        <button class="drawn-btn" data-prev aria-label="previous photo" disabled>
          <Drawn name="arrow-left" h={24} webH={28} />
        </button>
        <button class="drawn-btn" data-next aria-label="next photo">
          <Drawn name="arrow-right" h={24} webH={28} />
        </button>
      </div>
    )
  }
  </div>

  <!-- Zoom view: a tapped photo full screen; tap again to zoom in where you tapped. -->
  <dialog class="zoom" data-zoom-view aria-label={`${p.title} photos`}>
    <button class="zoom-close" data-zoom-close aria-label="close">×</button>
    <div class="zoom-stage" data-zoom-stage>
      <img class="zoom-img" data-zoom-img alt="" />
    </div>
    {
      photos.length > 1 && (
        <div class="zoom-nav">
          <button class="drawn-btn" data-zoom-prev aria-label="previous photo">
            <Drawn name="arrow-left" h={24} webH={28} />
          </button>
          <button class="drawn-btn" data-zoom-next aria-label="next photo">
            <Drawn name="arrow-right" h={24} webH={28} />
          </button>
        </div>
      )
    }
  </dialog>

  <div class="stack">
    <div class="info type">
      <h1 class="heading product-title">{p.title}</h1>
      <p class="price">{formatPrice(p.price)}</p>
      <p class="desc">{p.description}</p>

      <h2 class="heading sub">size</h2>
      <div class="sizes" role="group" aria-label="size" data-sizes>
        {
          sizes.map((s) => {
            const soldOut = (p.stock[s] ?? 0) <= 0;
            return (
              <button class="drawn-btn size" data-size={s} data-stock={p.stock[s]} data-sold={soldOut ? '' : undefined} aria-pressed="false" aria-label={soldOut ? `${s}, sold out` : s}>
                <Drawn name={`size-${s}`} h={31} webH={35} loading="eager" underline />
              </button>
            );
          })
        }
      </div>
      {
        p.sizeChart && (
          <details class="size-chart">
            <summary>
              <span class="sc-label">size chart</span>
              <span class="sc-plus" aria-hidden="true">+</span>
              <span class="sc-minus" aria-hidden="true">−</span>
            </summary>
            <table class="chart">
              <thead>
                <tr>{p.sizeChart.headers.map((h) => <th>{h}</th>)}</tr>
              </thead>
              <tbody>
                {p.sizeChart.rows.map((r) => (
                  <tr>{r.map((c) => <td>{c}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </details>
        )
      }
      <p class="msg" aria-live="polite" data-msg></p>

      <!-- Everything sold out, or a sold-out size picked: instead of "add to cart", leave an email to
           hear when it's back (worker/waitlist.ts). It needs a size picked to send. -->
      <form class="notify" data-notify hidden={!soldOut} data-all-sold-note={ALL_SOLD_NOTE} novalidate>
        <p class="notify-note" data-notify-note>{soldOut ? ALL_SOLD_NOTE : ''}</p>
        <div class="notify-row">
          <input class="notify-email" type="email" name="email" required maxlength="254" placeholder="your email" autocomplete="email" aria-label="your email" />
          <button class="notify-btn" type="submit">email me</button>
        </div>
        <!-- Only bots fill this in. -->
        <input class="notify-hp" type="text" name="gush_trap" tabindex="-1" autocomplete="one-time-code" aria-hidden="true" data-1p-ignore data-lpignore="true" data-form-type="other" />
      </form>

      <button class="drawn-btn boxed-btn add" data-add data-slug={p.slug} aria-label="add to cart" disabled={soldOut} hidden={soldOut}>
        <Drawn name="btn-add-to-cart" h={37} webH={42} underline />
      </button>
    </div>

    <div class="type">
      <h2 class="heading">the details</h2>
      <dl class="details">
        {
          p.details.map((d) => (
            <>
              <dt>{d.label}</dt>
              <dd>{d.value}</dd>
            </>
          ))
        }
      </dl>
    </div>

  </div>
  </div>
</Base>

<style>
  /* Big screens: photos on the left (sticky), details on the right. */
  @media (min-width: 900px) {
    .item-layout {
      display: grid;
      /* Photos get the bigger share of the width. */
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 40px;
      max-width: var(--wide);
      margin: 0 auto;
      padding: 20px 32px 48px;
      align-items: start;
    }

    .item-media {
      position: sticky;
      top: 20px;
    }

    /* Vertical line between the photos and the details. */
    .item-layout .stack {
      max-width: none;
      margin: 0;
      padding: 52px 0 0 40px;
      border-left: 1.5px solid var(--ink);
      align-self: stretch;
    }
  }

  .back {
    display: inline-block;
    margin: 10px var(--gutter) 10px;
  }

  /* One whole photo at a time (no neighbours peeking in); swipe or use the arrows for the next.
     Height is capped so the whole photo and the arrows fit on screen without scrolling. */
  .gallery {
    --photo-max-h: calc(100dvh - 300px);
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  @media (min-width: 700px) {
    .gallery {
      --photo-max-h: calc(100dvh - 390px);
    }
  }


  .gallery::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    max-height: var(--photo-max-h);
    object-fit: contain;
    scroll-snap-align: start;
  }

  .gallery-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 36px;
    padding: 12px 0 0;
  }

  .gallery-nav .drawn-btn:disabled {
    opacity: 0.25;
  }

  .slide {
    cursor: zoom-in;
  }

  /* Zoom view: full screen on white. The photo fits the screen; zoomed, it's scaled up around the
     point under your finger or mouse. */
  .zoom {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--fabric);
    overflow: hidden;
  }

  .zoom[open] {
    display: flex;
    flex-direction: column;
  }

  .zoom::backdrop {
    background: var(--fabric);
  }

  .zoom-close {
    position: absolute;
    top: 8px;
    right: 12px;
    z-index: 2;
    width: 40px;
    height: 40px;
    padding: 0 0 3px;
    border: 1.5px solid var(--ink);
    background: var(--page);
    color: var(--ink);
    font: 30px/1 var(--type);
    cursor: pointer;
  }

  .zoom-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 52px 16px 8px;
    overflow: hidden;
  }

  .zoom-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform 0.15s ease-out;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zoom-img.zoomed {
    cursor: zoom-out;
    transform: scale(2.5);
    transition: none;
    touch-action: none;
  }

  .zoom-nav {
    display: flex;
    justify-content: center;
    gap: 36px;
    padding: 10px 0 calc(18px + env(safe-area-inset-bottom));
  }




  .info {
    margin-top: 6px;
  }

  .price {
    margin: 6px 0 10px;
    color: var(--gray);
  }

  .desc {
    margin: 0 0 18px;
  }

  .sub {
    margin-top: 6px;
  }

  /* Sizes drawn at the same height so the letters match (XL is just wider). */
  .sizes {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 18px;
    /* room below for the sewn underline */
    margin: 10px 0 14px;
  }

  .size {
    position: relative;
  }

  /* Sold out: the whole drawing goes gray: the ink to about the price gray (#7a7a7a), the white fill
     to a light gray. It can still be picked, to join the waitlist. */
  .size[data-sold] :global(.drawn) {
    filter: contrast(0.31) brightness(1.3);
  }

  /* Hovering a sold-out size says so, in a small label where its underline would go (instead of the
     underline, until it's picked). */
  .size[data-sold]:not([aria-pressed='true']):hover :global(.sew-line) {
    opacity: 0;
  }

  .size[data-sold]:not([aria-pressed='true']):hover::after {
    content: 'sold out';
    position: absolute;
    top: 100%;
    left: 0;
    white-space: nowrap;
    font-size: 12px;
    color: var(--gray);
    pointer-events: none;
  }

  .msg {
    min-height: 1.5em;
    margin: 0 0 6px;
    color: var(--red);
  }

  /* Lined up on the left with the title, price and sizes above it. */
  .add {
    display: block;
    margin: 0;
  }

  .add:disabled {
    opacity: 0.4;
  }

  .add[hidden] {
    display: none;
  }

  /* The waitlist form: typed, boxed in the same 1.5px ink line as the rest of the site. */
  /* "XL is sold out. leave your email…" in red; the "got it" after signing up in black. */
  .notify-note {
    margin: 0 0 10px;
    color: var(--red);
  }

  .notify-note.done {
    color: var(--ink);
  }

  .notify-row {
    display: flex;
    max-width: 420px;
  }

  .notify-email,
  .notify-btn {
    font: inherit;
    font-size: 16px; /* 16px+ so phones don't zoom in on the field */
    color: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: 0;
    padding: 9px 12px;
    background: var(--page);
  }

  .notify-email {
    flex: 1;
    min-width: 0;
  }

  .notify-email::placeholder {
    color: var(--gray);
  }

  .notify-email:focus {
    outline: none;
    box-shadow: inset 0 -3px 0 var(--ink);
  }

  .notify-btn {
    margin-left: -1.5px;
    cursor: pointer;
    white-space: nowrap;
  }

  .notify-btn:hover,
  .notify-btn:focus-visible {
    background: var(--ink);
    color: var(--page);
    outline: none;
  }

  .notify-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .notify-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* Size chart folds open under the sizes; the + turns into a − while it's open. */
  .size-chart {
    margin: 4px 0 10px;
  }

  /* Plain clickable text: no box, no highlight. */
  .size-chart summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  /* Underline the words only, not the +/−. */
  .sc-label {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .size-chart[open] .chart {
    margin-top: 14px;
  }



  .size-chart summary::-webkit-details-marker {
    display: none;
  }

  .size-chart .sc-minus,
  .size-chart[open] .sc-plus {
    display: none;
  }

  .size-chart[open] .sc-minus {
    display: inline;
  }

  .sc-plus,
  .sc-minus {
    display: inline;
    width: 1ch;
    text-align: center;
  }

  /* Wide close-up shots (like the knit texture) fill the frame instead of floating as a thin strip. */
  .slide.fill {
    object-fit: cover;
  }

  .shake {
    animation: shake 0.35s;
  }

  @keyframes shake {
    25% { transform: translateX(-6px) rotate(-1deg); }
    75% { transform: translateX(6px) rotate(1deg); }
  }

  .details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 12px 0 0;
  }

  .details dt {
    color: var(--ink-soft);
  }

  .details dd {
    margin: 0;
  }

  .chart {
    width: 100%;
    margin-top: 12px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .chart th,
  .chart td {
    padding: 4px 6px;
    text-align: left;
    border-bottom: 1px dashed rgba(31, 27, 22, 0.35);
  }
</style>

<script>
  import { addToCart } from '../../scripts/cart';

  // If you came from the shop, "back" returns to the same spot in the feed.
  const back = document.querySelector<HTMLAnchorElement>('[data-back]')!;
  back.addEventListener('click', (e) => {
    if (document.referrer && new URL(document.referrer).pathname.replace(/\/$/, '') === '/shop') {
      e.preventDefault();
      history.back();
    }
  });

  // Photo strip: arrows step one photo at a time and fade out at the ends.
  const gallery = document.querySelector<HTMLElement>('[data-gallery]')!;
  const slides = [...gallery.querySelectorAll<HTMLElement>('.slide')];
  const prev = document.querySelector<HTMLButtonElement>('[data-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-next]');
  // Where each photo starts within the strip, and which one is closest to the current scroll.
  const startOf = (i: number) => slides[i].offsetLeft - slides[0].offsetLeft;
  const current = () => {
    let best = 0;
    slides.forEach((_, i) => {
      if (Math.abs(startOf(i) - gallery.scrollLeft) < Math.abs(startOf(best) - gallery.scrollLeft)) best = i;
    });
    return best;
  };
  const sync = () => {
    if (prev) prev.disabled = gallery.scrollLeft <= 2;
    if (next) next.disabled = gallery.scrollLeft >= gallery.scrollWidth - gallery.clientWidth - 2;
  };
  const step = (dir: number) => {
    const i = Math.min(Math.max(current() + dir, 0), slides.length - 1);
    gallery.scrollTo({ left: startOf(i), behavior: 'smooth' });
  };
  gallery.addEventListener('scroll', sync, { passive: true });
  prev?.addEventListener('click', () => step(-1));
  next?.addEventListener('click', () => step(1));
  sync();

  // Zoom view. Tap a photo to open it; tap again to zoom in at that spot, then drag (or move the
  // mouse) to look around. Arrows/arrow keys switch photos; ×, Esc or a tap outside closes.
  const zoomView = document.querySelector<HTMLDialogElement>('[data-zoom-view]')!;
  const zoomImg = zoomView.querySelector<HTMLImageElement>('[data-zoom-img]')!;
  const zoomStage = zoomView.querySelector<HTMLElement>('[data-zoom-stage]')!;
  let zoomIndex = 0;
  // Zoomed in, the photo scales around this point (fractions of its width/height).
  let origin = { x: 0.5, y: 0.5 };
  const setOrigin = (x: number, y: number) => {
    origin = { x: Math.min(Math.max(x, 0), 1), y: Math.min(Math.max(y, 0), 1) };
    zoomImg.style.transformOrigin = `${origin.x * 100}% ${origin.y * 100}%`;
  };
  const unzoom = () => zoomImg.classList.remove('zoomed');
  const showPhoto = (i: number) => {
    zoomIndex = (i + slides.length) % slides.length;
    const slide = slides[zoomIndex] as HTMLImageElement;
    unzoom();
    zoomImg.src = slide.dataset.zoom ?? slide.currentSrc;
    zoomImg.alt = slide.alt;
  };
  slides.forEach((slide, i) =>
    slide.addEventListener('click', () => {
      showPhoto(i);
      zoomView.showModal();
      document.documentElement.style.overflow = 'hidden';
    }),
  );
  zoomView.addEventListener('close', () => {
    unzoom();
    document.documentElement.style.overflow = '';
    gallery.scrollTo({ left: startOf(zoomIndex) });
  });
  zoomView.querySelector('[data-zoom-close]')!.addEventListener('click', () => zoomView.close());
  zoomView.querySelector('[data-zoom-prev]')?.addEventListener('click', () => showPhoto(zoomIndex - 1));
  zoomView.querySelector('[data-zoom-next]')?.addEventListener('click', () => showPhoto(zoomIndex + 1));
  zoomView.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') showPhoto(zoomIndex - 1);
    if (e.key === 'ArrowRight') showPhoto(zoomIndex + 1);
  });
  // A tap on the empty space around the photo closes the view.
  zoomStage.addEventListener('click', (e) => {
    if (e.target === zoomStage) zoomView.close();
  });

  // Tap/click the photo: zoom in at that point, or back out. While zoomed, the mouse moves the view
  // with it; a finger (or mouse) drag pans.
  let base = zoomImg.getBoundingClientRect(); // the photo's box on screen when not zoomed
  let drag: { x: number; y: number; ox: number; oy: number; moved: boolean } | null = null;
  zoomImg.addEventListener('pointerdown', (e) => {
    drag = { x: e.clientX, y: e.clientY, ox: origin.x, oy: origin.y, moved: false };
    if (zoomImg.classList.contains('zoomed')) zoomImg.setPointerCapture(e.pointerId);
  });
  zoomImg.addEventListener('pointermove', (e) => {
    if (!zoomImg.classList.contains('zoomed')) return;
    if (drag && (drag.moved || Math.abs(e.clientX - drag.x) + Math.abs(e.clientY - drag.y) > 4)) {
      drag.moved = true;
      setOrigin(drag.ox - (e.clientX - drag.x) / (base.width * 1.5), drag.oy - (e.clientY - drag.y) / (base.height * 1.5));
    } else if (e.pointerType === 'mouse' && !drag) {
      setOrigin((e.clientX - base.left) / base.width, (e.clientY - base.top) / base.height);
    }
  });
  zoomImg.addEventListener('pointerup', (e) => {
    const wasDrag = drag?.moved;
    drag = null;
    if (wasDrag) return;
    if (zoomImg.classList.contains('zoomed')) {
      unzoom();
    } else {
      base = zoomImg.getBoundingClientRect();
      setOrigin((e.clientX - base.left) / base.width, (e.clientY - base.top) / base.height);
      zoomImg.classList.add('zoomed');
    }
  });
  zoomImg.addEventListener('pointercancel', () => (drag = null));

  // Size picking + add to cart.
  const sizeGroup = document.querySelector<HTMLElement>('[data-sizes]')!;
  const sizeButtons = [...sizeGroup.querySelectorAll<HTMLButtonElement>('[data-size]')];
  const msg = document.querySelector<HTMLElement>('[data-msg]')!;
  const add = document.querySelector<HTMLButtonElement>('[data-add]')!;
  const notify = document.querySelector<HTMLFormElement>('[data-notify]')!;
  const notifyNote = notify.querySelector<HTMLElement>('[data-notify-note]')!;
  const notifyEmail = notify.querySelector<HTMLInputElement>('input[name=email]')!;
  const notifyBtn = notify.querySelector<HTMLButtonElement>('button')!;
  const title = document.querySelector('.product-title')!.textContent!.trim();
  let size: string | null = null;
  const isSold = (b: HTMLButtonElement) => b.dataset.sold !== undefined;

  // The email box replaces "add to cart" when the picked size is sold out, or when everything is
  // sold out (then it shows before a size is picked, but won't send until one is).
  const updateNotify = () => {
    const picked = sizeButtons.find((b) => b.dataset.size === size);
    const allGone = sizeButtons.every(isSold);
    const on = picked ? isSold(picked) : allGone;
    notify.hidden = !on;
    add.hidden = on;
    add.disabled = allGone;
    if (on) {
      notifyNote.textContent = picked
        ? `${size!.toUpperCase()} is sold out. leave your email and we’ll let you know when it’s back.`
        : notify.dataset.allSoldNote!;
      notifyNote.classList.remove('done');
      notifyEmail.disabled = notifyBtn.disabled = false;
      notifyEmail.hidden = notifyBtn.hidden = false;
    }
  };

  const shakeSizes = () => {
    msg.textContent = 'choose a size first.';
    sizeGroup.classList.remove('shake');
    void sizeGroup.offsetWidth;
    sizeGroup.classList.add('shake');
  };

  const pickSize = (b: HTMLButtonElement) => {
    size = b.dataset.size!;
    sizeButtons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    msg.textContent = '';
    updateNotify();
  };

  notify.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!size) return shakeSizes();
    const email = notifyEmail.value.trim();
    if (!/^\S+@\S+\.\S+$/.test(email)) {
      msg.textContent = 'that email doesn’t look right.';
      notifyEmail.focus();
      return;
    }
    msg.textContent = '';
    notifyBtn.disabled = true;
    const picked = size!;
    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug: add.dataset.slug, size: picked, email, gush_trap: (notify.elements.namedItem('gush_trap') as HTMLInputElement).value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'something went wrong. try again?');
      notifyNote.textContent = data.already
        ? `you’re already on the list for ${title} in ${picked.toUpperCase()}. we’ll email you when it’s back.`
        : `got it. we’ll email you when ${title} in ${picked.toUpperCase()} is back.`;
      notifyNote.classList.add('done');
      notifyEmail.hidden = notifyBtn.hidden = true;
    } catch (err) {
      msg.textContent = err instanceof Error && !(err instanceof TypeError) ? err.message : 'something went wrong. try again?';
      notifyBtn.disabled = false;
    }
  });
  sizeButtons.forEach((b) => b.addEventListener('click', () => pickSize(b)));

  // Coming from the cart (?size=m): start with that size picked, if it's still available.
  const wanted = new URL(location.href).searchParams.get('size');
  const preset = sizeButtons.find((b) => b.dataset.size === wanted && !isSold(b));
  if (preset) pickSize(preset);

  // Live stock: the page was built with the starting counts, so ask the site what's left now and
  // gray out anything that has sold out since.
  fetch('/api/stock', { cache: 'no-store' })
    .then((r) => (r.ok ? r.json() : null))
    .then((all: Record<string, Record<string, number>> | null) => {
      const live = all?.[add.dataset.slug!];
      if (!live) return;
      for (const b of sizeButtons) {
        const left = live[b.dataset.size!];
        if (left === undefined) continue;
        b.dataset.stock = String(left);
        if (left <= 0) b.dataset.sold = '';
        else delete b.dataset.sold;
        b.setAttribute('aria-label', left <= 0 ? `${b.dataset.size}, sold out` : b.dataset.size!);
      }
      // Don't undo a signup that just went through.
      if (!notifyEmail.hidden) updateNotify();
    })
    .catch(() => {});

  add.addEventListener('click', () => {
    if (!size) return shakeSizes();
    const stock = Number(sizeButtons.find((b) => b.dataset.size === size)!.dataset.stock);
    if (addToCart(add.dataset.slug!, size, stock)) {
      location.href = '/cart';
      return;
    }
    msg.textContent = `that's all we have in ${size.toUpperCase()}. it's in your cart.`;
  });
</script>
