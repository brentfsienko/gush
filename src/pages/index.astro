---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Drawn from '../components/Drawn.astro';
import { homePhotos } from '../data/assets';
import { ABOUT, SECOND_BLURB } from '../data/home';

const [hero, ...rest] = homePhotos();
---

<Base>
  <div class="stack home">
    {
      hero && (
        <div class="hero">
          <Image src={hero} alt="GÜSH blue thermal" widths={[480, 900]} sizes="(min-width: 480px) 400px, 85vw" class="photo" loading="eager" />
        </div>
      )
    }

    <div class="type">
      <h2 class="heading">what is GÜSH?</h2>
      <p class="blurb">{ABOUT}</p>
    </div>

    {
      rest.length > 0 && (
        <div class="photos">
          {rest.map((src) => (
            <Image src={src} alt="GÜSH blue thermal" widths={[480, 900, 1200]} sizes="(min-width: 700px) 600px, 100vw" class="photo" />
          ))}
        </div>
      )
    }

    <div class="type">
      <p class="blurb">{SECOND_BLURB}</p>
    </div>

    <a href="/shop" class="center cta" aria-label="shop">
      <Drawn name="tab-shop" h={96} />
    </a>
  </div>
</Base>

<style>
  .home {
    padding-top: 22px;
  }

  .blurb {
    margin: 12px 0 0;
  }

  .photos {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .cta {
    padding: 8px 0 12px;
  }
</style>
