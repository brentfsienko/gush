---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Drawn from '../components/Drawn.astro';
import { PRODUCTS } from '../data/products';
import { SHIPPING_CENTS, MAX_QTY } from '../data/store';
import { productPhotos } from '../data/assets';

// Everything the cart needs to draw a line, keyed by slug (the cart itself lives in the browser).
const catalog = Object.fromEntries(
  await Promise.all(
    PRODUCTS.map(async (p) => {
      const [first] = productPhotos(p.slug);
      return [
        p.slug,
        {
          title: p.title,
          price: p.price,
          stock: p.stock,
          thumb: first ? (await getImage({ src: first, width: 300, format: 'webp' })).src : null,
        },
      ];
    }),
  ),
);
const config = { catalog, shipping: SHIPPING_CENTS, maxQty: MAX_QTY };
---

<Base title="cart" tab="cart">
  <div class="stack">
    <div data-full hidden>
      <div class="center">
        <h2 class="heading">your cart</h2>
      </div>
      <div class="lines" data-lines></div>

      <div class="type summary">
        <dl>
          <dt>subtotal</dt>
          <dd data-subtotal></dd>
          <dt>shipping</dt>
          <dd data-shipping></dd>
          <dt class="total">total</dt>
          <dd class="total" data-total></dd>
        </dl>
      </div>

      <p class="msg" aria-live="polite" data-msg></p>
      <div class="center">
        <button class="drawn-btn boxed-btn" data-checkout aria-label="checkout">
          <Drawn name="btn-checkout" h={66} webH={80} />
        </button>
      </div>
    </div>

    <div data-empty hidden>
      <div class="empty">
        <h2 class="heading">your cart is empty</h2>
        <a href="/shop" aria-label="keep shopping"><Drawn name="btn-keep-shopping" h={48} webH={60} /></a>
      </div>
    </div>
  </div>

  <template data-line-tpl>
    <div class="line">
      <img class="photo thumb" data-thumb alt="" />
      <div class="line-info">
        <a class="line-title" data-title></a>
        <p class="line-sub"><span data-size></span> · <span data-price></span></p>
        <div class="qty">
          <button class="drawn-btn" data-minus aria-label="one less"><Drawn name="btn-minus" h={16} webH={18} loading="eager" /></button>
          <span class="qty-n" data-qty></span>
          <button class="drawn-btn" data-plus aria-label="one more"><Drawn name="btn-plus" h={32} webH={36} loading="eager" /></button>
        </div>
      </div>
      <button class="drawn-btn remove" data-remove aria-label="remove"><Drawn name="btn-remove" h={20} webH={24} loading="eager" /></button>
    </div>
  </template>

  <script is:inline type="application/json" id="cart-config" set:html={JSON.stringify(config)} />
</Base>

<style>
  .lines {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 16px 0 20px;
  }

  /* On hover the whole item gets the same box as shop items: black outline, white fill and a hard
     mustard shadow down-left. Padding (pulled back with negative margin) gives the box room, and the
     border is always there (transparent) so nothing shifts. */
  :global(.line) {
    position: relative;
    display: flex;
    gap: 14px;
    padding: 8px;
    margin: 0 -8px;
    border: 1.5px solid transparent;
    background: var(--page);
    transition: border-color 0.1s steps(2), box-shadow 0.1s steps(2), transform 0.1s steps(2);
    align-items: center;
  }

  :global(.thumb) {
    width: 92px;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    flex-shrink: 0;
  }

  :global(.line-info) {
    flex: 1;
    min-width: 0;
  }

  :global(.line) {
    cursor: pointer;
  }

  :global(.line-title) {
    display: block;
    color: inherit;
    text-decoration: none;
    font-size: 18px;
    /* Room for REMOVE in the corner, so long names wrap before reaching it. */
    padding-right: 76px;
  }

  :global(.line-sub) {
    margin: 4px 0 6px;
  }

  :global(.qty) {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  :global(.qty-n) {
    font-size: 18px;
    min-width: 1.5ch;
    text-align: center;
    --digit-h: 30px;
  }

  :global(.qty .drawn-btn:disabled) {
    opacity: 0.3;
  }

  @media (hover: hover) {
    :global(.line:hover) {
      border-color: var(--ink);
      box-shadow: -4px 4px 0 var(--sun);
      transform: translate(1px, -1px);
    }
  }

  /* REMOVE sits in the item's upper-right corner. */
  :global(.remove) {
    position: absolute;
    top: 8px;
    right: 8px;
  }

  .summary dl {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 12px;
    margin: 0;
  }

  .summary dd {
    margin: 0;
    text-align: right;
  }

  .summary .total {
    font-size: 19px;
    padding-top: 6px;
    border-top: 1px dashed rgba(31, 27, 22, 0.4);
  }

  .msg {
    min-height: 1.5em;
    margin: 14px 0 6px;
    text-align: center;
    color: var(--red);
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-block: 44px;
    margin-top: 30px;
  }
</style>

<script>
  import { readCart, writeCart, setQty, type CartLine } from '../scripts/cart';
  import { drawNumber } from '../scripts/digits';

  type Item = { title: string; price: number; stock: Record<string, number>; thumb: string | null };
  const config = JSON.parse(document.getElementById('cart-config')!.textContent!) as {
    catalog: Record<string, Item>;
    shipping: number;
    maxQty: number;
  };

  const $ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const money = (c: number) => `$${(c / 100).toFixed(2)}`;
  const tpl = $<HTMLTemplateElement>('[data-line-tpl]');
  const linesEl = $('[data-lines]');
  const msg = $('[data-msg]');
  const checkout = $<HTMLButtonElement>('[data-checkout]');

  function render() {
    // Drop anything that's no longer in the catalog.
    const lines = readCart().filter((l) => config.catalog[l.slug]);
    $('[data-full]').hidden = lines.length === 0;
    $('[data-empty]').hidden = lines.length > 0;
    linesEl.replaceChildren(...lines.map(lineEl));

    const subtotal = lines.reduce((s, l) => s + config.catalog[l.slug].price * l.qty, 0);
    $('[data-subtotal]').textContent = money(subtotal);
    $('[data-shipping]').textContent = config.shipping ? money(config.shipping) : 'free';
    $('[data-total]').textContent = money(subtotal + config.shipping);
  }

  function lineEl(l: CartLine) {
    const item = config.catalog[l.slug];
    const el = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;

    const thumb = $<HTMLImageElement>('[data-thumb]', el);
    if (item.thumb) thumb.src = item.thumb;
    else thumb.remove();

    // Clicking the item (anywhere but its buttons) opens its page with this size already picked.
    const href = `/item/${l.slug}?size=${encodeURIComponent(l.size)}`;
    const title = $<HTMLAnchorElement>('[data-title]', el);
    title.textContent = item.title;
    title.href = href;
    el.addEventListener('click', (e) => {
      if ((e.target as Element).closest('button, a')) return;
      location.href = href;
    });

    $('[data-size]', el).textContent = `size ${l.size.toUpperCase()}`;
    $('[data-price]', el).textContent = money(item.price);
    drawNumber($('[data-qty]', el), l.qty);

    const max = Math.min(config.maxQty, item.stock[l.size] ?? 0);
    $<HTMLButtonElement>('[data-plus]', el).disabled = l.qty >= max;
    $('[data-plus]', el).addEventListener('click', () => (setQty(l.slug, l.size, l.qty + 1), render()));
    $('[data-minus]', el).addEventListener('click', () => (setQty(l.slug, l.size, l.qty - 1), render()));
    $('[data-remove]', el).addEventListener('click', () => (setQty(l.slug, l.size, 0), render()));
    return el;
  }

  checkout.addEventListener('click', async () => {
    checkout.disabled = true;
    checkout.style.opacity = '0.5';
    msg.textContent = 'one sec...';
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ items: readCart() }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.url) {
        location.href = data.url;
        return;
      }
      msg.textContent = data.error ?? 'checkout isn’t working right now. try again in a bit.';
    } catch {
      msg.textContent = 'couldn’t reach checkout. check your connection and try again.';
    }
    checkout.disabled = false;
    checkout.style.opacity = '';
  });

  // Clean up anything stale before showing the cart: removed products, or more than is in stock.
  writeCart(
    readCart()
      .filter((l) => config.catalog[l.slug])
      .map((l) => ({ ...l, qty: Math.min(l.qty, config.maxQty, config.catalog[l.slug].stock[l.size] ?? 0) }))
      .filter((l) => l.qty > 0),
  );
  render();
  addEventListener('pageshow', (e) => e.persisted && render());
</script>
