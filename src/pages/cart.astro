---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Drawn from '../components/Drawn.astro';
import { PRODUCTS, formatPrice } from '../data/products';
import { SHIPPING_OPTIONS, MAX_QTY, FREE_SHIPPING_OVER } from '../data/store';
import { productPhotos } from '../data/assets';

// Everything the cart needs to draw a line, keyed by slug (the cart itself lives in the browser).
const catalog = Object.fromEntries(
  await Promise.all(
    PRODUCTS.map(async (p) => {
      const [first] = productPhotos(p.slug);
      return [
        p.slug,
        {
          title: p.title,
          price: p.price,
          stock: p.stock,
          thumb: first ? (await getImage({ src: first, width: 300, format: 'webp' })).src : null,
        },
      ];
    }),
  ),
);
// e.g. "free in Seattle, $8 elsewhere in the US" (picked on the checkout page).
const shipping = [...SHIPPING_OPTIONS]
  .sort((a, b) => a.cents - b.cents)
  .map((o) => `${o.cents ? formatPrice(o.cents) : 'free'} ${o.where}`)
  .join(', ');
const config = { catalog, maxQty: MAX_QTY, freeOver: FREE_SHIPPING_OVER, shipping: FREE_SHIPPING_OVER ? `${shipping} · free over ${formatPrice(FREE_SHIPPING_OVER)}` : shipping };
---

<Base title="cart" tab="cart">
  <div class="stack">
    <div data-full hidden>
      <div class="center">
        <h2 class="heading">your cart</h2>
      </div>
      <div class="lines" data-lines></div>

      <div class="type summary">
        <dl>
          <dt>subtotal</dt>
          <dd data-subtotal></dd>
          <dt class="code-dt" data-code-row hidden>
            code <span data-code-name></span>
            <button class="link-btn" type="button" data-code-remove>remove</button>
          </dt>
          <dd data-code-row data-code-off hidden></dd>
          <dt>shipping</dt>
          <dd class="ship" data-ship>{config.shipping}</dd>
        </dl>
        <p class="code-love" data-code-love hidden></p>

        <!-- Promo codes can go in here (checked with Stripe by worker/codes.ts, then already applied at
             checkout) or on Stripe's own page. -->
        <div class="code-box" data-code-box>
          <button class="link-btn" type="button" data-code-open>have a code?</button>
          <form class="code-form" data-code-form hidden novalidate>
            <input name="code" type="text" maxlength="40" placeholder="code" aria-label="code" autocomplete="off" autocapitalize="characters" spellcheck="false" />
            <button class="code-btn" type="submit">apply</button>
          </form>
          <p class="code-err" data-code-err aria-live="polite"></p>
        </div>
      </div>

      <p class="msg" aria-live="polite" data-msg></p>
      <div class="center">
        <button class="drawn-btn boxed-btn" data-checkout aria-label="checkout">
          <Drawn name="btn-checkout" h={48} webH={58} underline />
        </button>
      </div>
    </div>

    <div data-empty hidden>
      <div class="empty">
        <h2 class="heading">your cart is empty</h2>
        <a href="/shop" aria-label="keep shopping"><Drawn name="btn-keep-shopping" h={44} webH={55} underline /></a>
      </div>
    </div>
  </div>

  <template data-line-tpl>
    <div class="line sewn-box sew-hover">
      <img class="photo thumb" data-thumb alt="" />
      <div class="line-info">
        <a class="line-title" data-title></a>
        <p class="line-sub"><span data-size></span> · <span data-price></span></p>
        <div class="qty">
          <button class="drawn-btn" data-minus aria-label="one less"><Drawn name="btn-minus" h={10} webH={11} loading="eager" /></button>
          <span class="qty-n" data-qty></span>
          <button class="drawn-btn" data-plus aria-label="one more"><Drawn name="btn-plus" h={20} webH={22} loading="eager" /></button>
        </div>
      </div>
      <button class="drawn-btn remove" data-remove aria-label="remove"><Drawn name="btn-remove" h={19} webH={23} loading="eager" underline /></button>
    </div>
  </template>

  <script is:inline type="application/json" id="cart-config" set:html={JSON.stringify(config)} />
</Base>

<style>
  .lines {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 16px 0 20px;
  }

  /* On hover the whole item gets the same box as shop items: black outline, white fill and a hard
     mustard shadow down-left. Padding (pulled back with negative margin) gives the box room, and the
     border is always there (transparent) so nothing shifts. */
  :global(.line) {
    position: relative;
    display: flex;
    gap: 14px;
    padding: 8px;
    margin: 0 -8px;
    background: transparent;
    align-items: center;
  }

  :global(.thumb) {
    width: 92px;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    flex-shrink: 0;
  }

  :global(.line-info) {
    flex: 1;
    min-width: 0;
  }

  :global(.line) {
    cursor: pointer;
  }

  :global(.line-title) {
    display: block;
    color: inherit;
    text-decoration: none;
    font-size: 18px;
    /* Room for REMOVE in the corner, so long names wrap before reaching it. */
    padding-right: 76px;
  }

  :global(.line-sub) {
    margin: 4px 0 6px;
  }

  :global(.qty) {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  :global(.qty-n) {
    font-size: 18px;
    min-width: 1.5ch;
    text-align: center;
    --digit-h: 20px;
  }

  :global(.qty .drawn-btn:disabled) {
    opacity: 0.3;
  }


  /* REMOVE sits in the item's upper-right corner. */
  :global(.remove) {
    position: absolute;
    top: 8px;
    right: 8px;
  }

  .summary dl {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 12px;
    margin: 0;
  }

  .summary dd {
    margin: 0;
    text-align: right;
  }

  /* Both shipping choices, in gray; the shopper picks one on the checkout page. */
  .summary .ship {
    max-width: 22ch;
    color: var(--gray);
  }

  /* The code box: a line to write on and a plain box button, like the newsletter sign-up. */
  .link-btn {
    padding: 0;
    font: inherit;
    font-size: 14px;
    color: var(--gray);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .link-btn:hover,
  .link-btn:focus-visible {
    color: var(--ink);
    outline: none;
  }

  .code-dt .link-btn {
    margin-left: 6px;
    font-size: 12px;
  }

  [hidden] {
    display: none !important;
  }

  .code-box {
    margin-top: 14px;
  }

  .code-form {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    max-width: 320px;
  }

  .code-form input {
    flex: 1;
    min-width: 0;
    padding: 6px 0;
    font: inherit;
    font-size: 16px;
    text-transform: uppercase;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1.5px solid var(--ink);
    border-radius: 0;
  }

  .code-form input::placeholder {
    text-transform: none;
    color: var(--gray);
  }

  .code-form input:focus {
    outline: none;
    border-bottom-width: 3px;
    padding-bottom: 4.5px;
  }

  .code-btn {
    flex-shrink: 0;
    padding: 7px 12px;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    background: var(--page);
    border: 1.5px solid var(--ink);
    border-radius: 0;
    cursor: pointer;
  }

  .code-btn:hover:not(:disabled),
  .code-btn:focus-visible {
    background: var(--ink);
    color: var(--page);
    outline: none;
  }

  .code-btn:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .code-err {
    min-height: 1.3em;
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--red);
  }

  .code-love {
    margin: 8px 0 0;
    color: var(--red);
  }

  .msg {
    min-height: 1.5em;
    margin: 14px 0 6px;
    text-align: center;
    color: var(--red);
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-block: 44px;
    margin-top: 30px;
  }
</style>

<script>
  import { readCart, writeCart, setQty, type CartLine } from '../scripts/cart';
  import { drawNumber } from '../scripts/digits';
  import { hearts, loveNote } from '../scripts/hearts';

  type Item = { title: string; price: number; stock: Record<string, number>; thumb: string | null };
  const config = JSON.parse(document.getElementById('cart-config')!.textContent!) as {
    catalog: Record<string, Item>;
    maxQty: number;
    freeOver: number;
    shipping: string;
  };

  const $ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const money = (c: number) => `$${(c / 100).toFixed(2)}`;
  const tpl = $<HTMLTemplateElement>('[data-line-tpl]');
  const linesEl = $('[data-lines]');
  const msg = $('[data-msg]');
  const checkout = $<HTMLButtonElement>('[data-checkout]');

  function render() {
    // Drop anything that's no longer in the catalog.
    const lines = readCart().filter((l) => config.catalog[l.slug]);
    $('[data-full]').hidden = lines.length === 0;
    $('[data-empty]').hidden = lines.length > 0;
    linesEl.replaceChildren(...lines.map(lineEl));

    const subtotal = lines.reduce((s, l) => s + config.catalog[l.slug].price * l.qty, 0);
    $('[data-subtotal]').textContent = money(subtotal);
    $('[data-ship]').textContent = config.freeOver && subtotal >= config.freeOver ? 'free' : config.shipping;
    renderCode(lines);
  }

  // ---- promo code (the "have a code?" box) ----
  type Code = { code: string; slugs: string[] | null; amountOff: number | null; percentOff: number | null; message?: string };
  const CODE_KEY = 'gush-code';
  const codeForm = $<HTMLFormElement>('[data-code-form]');
  const codeInput = $<HTMLInputElement>('input[name=code]', codeForm);
  const codeOpen = $<HTMLButtonElement>('[data-code-open]');
  const codeErr = $('[data-code-err]');
  const codeLove = $('[data-code-love]');
  let code: Code | null = null;
  try {
    code = JSON.parse(sessionStorage.getItem(CODE_KEY) ?? 'null');
  } catch {}
  const saveCode = () => {
    try {
      if (code) sessionStorage.setItem(CODE_KEY, JSON.stringify(code));
      else sessionStorage.removeItem(CODE_KEY);
    } catch {}
  };

  /** What the code takes off this cart (Stripe works out the real amount at checkout). */
  function discount(lines: CartLine[], c: Code) {
    const eligible = lines
      .filter((l) => !c.slugs || c.slugs.includes(l.slug))
      .reduce((s, l) => s + config.catalog[l.slug].price * l.qty, 0);
    if (c.amountOff) return Math.min(c.amountOff, eligible);
    if (c.percentOff) return Math.round((eligible * c.percentOff) / 100);
    return 0;
  }

  function renderCode(lines: CartLine[]) {
    const rows = document.querySelectorAll<HTMLElement>('[data-code-row]');
    rows.forEach((r) => (r.hidden = !code));
    codeOpen.hidden = !!code || !codeForm.hidden;
    if (code) codeForm.hidden = true;
    codeLove.hidden = !code?.message;
    if (!code) return;
    $('[data-code-name]').textContent = code.code;
    const off = discount(lines, code);
    $('[data-code-off]').textContent = off ? `−${money(off)}` : 'not for these items';
    codeLove.textContent = code.message ? `♥ ${code.message}` : '';
  }

  codeOpen.addEventListener('click', () => {
    codeForm.hidden = false;
    codeOpen.hidden = true;
    codeInput.focus();
  });

  $('[data-code-remove]').addEventListener('click', () => {
    code = null;
    saveCode();
    codeErr.textContent = '';
    render();
  });

  codeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const typed = codeInput.value.trim();
    if (!typed) return;
    const btn = $<HTMLButtonElement>('button[type=submit]', codeForm);
    btn.disabled = true;
    codeErr.textContent = '';
    try {
      const res = await fetch('/api/code', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ code: typed, items: readCart() }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) {
        codeErr.textContent = data.error ?? 'couldn’t check that code. try again in a bit.';
      } else {
        code = { code: data.code, slugs: data.slugs, amountOff: data.amountOff, percentOff: data.percentOff, message: data.message };
        saveCode();
        codeInput.value = '';
        render();
        if (code.message) {
          // The love note: hearts burst up from the code, and the message, big.
          const r = $('.summary').getBoundingClientRect();
          hearts((r.left + r.width / 2) / innerWidth, Math.min(0.85, (r.top + r.height / 2) / innerHeight));
          loveNote(code.message);
        }
      }
    } catch {
      codeErr.textContent = 'couldn’t check that code. check your connection and try again.';
    }
    btn.disabled = false;
  });

  function lineEl(l: CartLine) {
    const item = config.catalog[l.slug];
    const el = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;

    const thumb = $<HTMLImageElement>('[data-thumb]', el);
    if (item.thumb) thumb.src = item.thumb;
    else thumb.remove();

    // Clicking the item (anywhere but its buttons) opens its page with this size already picked.
    const href = `/item/${l.slug}?size=${encodeURIComponent(l.size)}`;
    const title = $<HTMLAnchorElement>('[data-title]', el);
    title.textContent = item.title;
    title.href = href;
    el.addEventListener('click', (e) => {
      if ((e.target as Element).closest('button, a')) return;
      location.href = href;
    });

    $('[data-size]', el).textContent = `size ${l.size.toUpperCase()}`;
    $('[data-price]', el).textContent = money(item.price);
    drawNumber($('[data-qty]', el), l.qty);

    const max = Math.min(config.maxQty, item.stock[l.size] ?? 0);
    $<HTMLButtonElement>('[data-plus]', el).disabled = l.qty >= max;
    $('[data-plus]', el).addEventListener('click', () => (setQty(l.slug, l.size, l.qty + 1), render()));
    $('[data-minus]', el).addEventListener('click', () => (setQty(l.slug, l.size, l.qty - 1), render()));
    $('[data-remove]', el).addEventListener('click', () => (setQty(l.slug, l.size, 0), render()));
    return el;
  }

  checkout.addEventListener('click', async () => {
    checkout.disabled = true;
    checkout.style.opacity = '0.5';
    msg.textContent = 'one sec...';
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ items: readCart(), code: code?.code }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.url) {
        location.href = data.url;
        return;
      }
      if (data.code === 'bad') {
        // The code stopped working (used up, or not for what's in the cart now): drop it.
        code = null;
        saveCode();
        render();
        codeErr.textContent = data.error;
        msg.textContent = '';
      } else msg.textContent = data.error ?? 'checkout isn’t working right now. try again in a bit.';
    } catch {
      msg.textContent = 'couldn’t reach checkout. check your connection and try again.';
    }
    checkout.disabled = false;
    checkout.style.opacity = '';
  });

  // Clean up anything stale before showing the cart: removed products, or more than is in stock.
  writeCart(
    readCart()
      .filter((l) => config.catalog[l.slug])
      .map((l) => ({ ...l, qty: Math.min(l.qty, config.maxQty, config.catalog[l.slug].stock[l.size] ?? 0) }))
      .filter((l) => l.qty > 0),
  );
  render();
  addEventListener('pageshow', (e) => e.persisted && render());
</script>
