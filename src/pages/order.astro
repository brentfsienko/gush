---
// A buyer's order tracking page. The address is /order/<private code>; the worker (worker/orders.ts,
// orderPage) fills in the timeline below before the page is sent. Opened without a valid code, it
// says the order wasn't found.
import Base from '../layouts/Base.astro';
import FamilyPickFields from '../components/FamilyPickFields.astro';
import { CONTACT_EMAIL } from '../data/store';
---

<Base title="your order" description="your GÜSH order." noindex>
  <article class="doc type ot">
    <div data-order>
      <h1 class="heading">we couldn’t find that order</h1>
      <p>check the link in your order email, or email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we’ll help.</p>
    </div>

    <!-- Family gifts only, until they're on the machine: the worker unhides this and fills in the
         current choices (worker/orders.ts, orderPage); otherwise it's removed. -->
    <section class="edit" data-edit hidden>
      <button class="btn" type="button" data-edit-open>edit your pick</button>
      <p class="edit-hint">you can change it until it’s on the machine.</p>
      <form class="edit-form" data-edit-form hidden novalidate>
        <h2 class="heading edit-title">edit your pick</h2>
        <FamilyPickFields />
        <div class="edit-nav">
          <button class="btn" type="submit">save changes</button>
          <button class="btn ghost" type="button" data-edit-cancel>cancel</button>
        </div>
        <p class="edit-msg" data-edit-msg aria-live="polite"></p>
      </form>
    </section>
  </article>
</Base>

<style>
  .edit {
    margin: 4px 0 8px;
    padding-top: 22px;
    border-top: 1px dashed rgba(31, 27, 22, 0.35);
  }

  .edit[hidden],
  .edit [hidden] {
    display: none !important;
  }

  .edit-hint {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--gray);
  }

  .edit-title {
    margin: 0 0 16px;
    font-size: 21px;
  }

  .edit-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .btn {
    padding: 9px 18px;
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    background: var(--page);
    border: 1.5px solid var(--ink);
    border-radius: 0;
    cursor: pointer;
  }

  .btn:hover:not(:disabled),
  .btn:focus-visible {
    background: var(--ink);
    color: var(--page);
    outline: none;
  }

  .btn.ghost {
    border-style: dashed;
  }

  .btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .edit-msg {
    min-height: 1.5em;
    margin: 12px 0 0;
    color: var(--red);
  }
</style>

<script>
  // "edit your pick": fill the form with the current choices, check it, save, then reload.
  const box = document.querySelector<HTMLElement>('[data-edit]');
  if (box && !box.hidden) {
    const token = location.pathname.split('/')[2] ?? '';
    const open = box.querySelector<HTMLButtonElement>('[data-edit-open]')!;
    const hint = box.querySelector<HTMLElement>('.edit-hint')!;
    const form = box.querySelector<HTMLFormElement>('[data-edit-form]')!;
    const pick = form.querySelector<HTMLElement>('[data-pick]')!;
    const msg = box.querySelector<HTMLElement>('[data-edit-msg]')!;
    const val = (n: string) => {
      const el = form.elements.namedItem(n) as RadioNodeList | HTMLInputElement | HTMLTextAreaElement | null;
      return el ? el.value.trim() : '';
    };
    const fill = () => {
      const d = box.dataset;
      for (const name of ['style', 'color', 'size'] as const) {
        const r = form.querySelector<HTMLInputElement>(`input[name=${name}][value="${CSS.escape(d[name] ?? '')}"]`);
        if (r) r.checked = true;
      }
      (form.elements.namedItem('bag') as HTMLInputElement).value = d.bag ?? '';
      (form.elements.namedItem('fit') as HTMLTextAreaElement).value = d.note ?? '';
      pick.dispatchEvent(new Event('gush:sync'));
    };
    const toggle = (editing: boolean) => {
      form.hidden = !editing;
      open.hidden = editing;
      hint.hidden = editing;
      msg.textContent = '';
    };
    open.addEventListener('click', () => {
      fill();
      toggle(true);
    });
    box.querySelector('[data-edit-cancel]')!.addEventListener('click', () => toggle(false));
    // Arriving from "change my pick" on the family page (…#edit): open the form right away.
    if (location.hash === '#edit') {
      fill();
      toggle(true);
      requestAnimationFrame(() => form.scrollIntoView({ block: 'start' }));
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const style = val('style');
      const problem = !style
        ? 'pick a gift.'
        : !val('color') && style !== 'mystery'
          ? 'pick a color.'
          : style === 'bag'
            ? !val('bag') && 'tell us what kind of bag.'
            : !val('size') && 'pick a size.';
      if (problem) {
        msg.textContent = problem;
        return;
      }
      const save = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      save.disabled = true;
      try {
        const res = await fetch(`/api/order/${encodeURIComponent(token)}/edit`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ style, color: val('color'), size: val('size'), bag: val('bag'), fit: val('fit') }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'that didn’t save. try again?');
        location.reload();
      } catch (err) {
        msg.textContent = err instanceof Error && !(err instanceof TypeError) ? err.message : 'that didn’t save. try again?';
        save.disabled = false;
      }
    });
  }
</script>

<!-- Global: the timeline is put in by the worker, so it doesn't carry this page's scoped-style tags. -->
<style is:global>
  .ot {
    max-width: 520px;
  }

  .ot-label {
    margin: 0 0 4px;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--gray);
  }

  .ot-title {
    margin: 0 0 18px;
    font-size: 28px;
  }

  .ot-dim {
    color: var(--gray);
  }

  .ot-items {
    list-style: none;
    margin: 0 0 30px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ot-item {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
  }

  .ot-item img {
    width: 72px;
    height: 72px;
    object-fit: contain;
    background: #fff;
    flex-shrink: 0;
  }

  .ot-item-name {
    font-size: 17px;
  }

  /* The timeline: a dot per step, joined by a line. Finished stretches are sewn (the same real
     stitch as under the header); what's still to come is a faint dashed line. */
  .ot-steps {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
  }

  .ot-step {
    position: relative;
    margin: 0;
    padding: 0 0 30px 36px;
  }

  .ot-step:last-child {
    padding-bottom: 0;
  }

  .ot-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 18px;
    bottom: 2px;
    width: 0;
    border-left: 1.5px dashed rgba(31, 27, 22, 0.25);
  }

  .ot-step.done:not(:last-child)::before {
    left: 3.5px;
    width: 7px;
    border: 0;
    background: url('../assets/stitch-side.png') center top / 7px auto repeat-y;
  }

  .ot-dot {
    position: absolute;
    left: 0;
    top: 4px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid var(--gray);
    background: var(--page);
  }

  .ot-step.done .ot-dot,
  .ot-step.now .ot-dot {
    border-color: var(--ink);
    background: var(--ink);
  }

  /* The current step gets a ring around its dot. */
  .ot-step.now .ot-dot {
    box-shadow: 0 0 0 4px var(--page), 0 0 0 5.5px var(--ink);
  }

  .ot-step-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
  }

  .ot-step-name {
    font-size: 17px;
  }

  .ot-step.todo .ot-step-name {
    color: var(--gray);
  }

  .ot-date {
    font-size: 13px;
    color: var(--gray);
  }

  .ot-detail {
    flex-basis: 100%;
    font-size: 14px;
  }

  a.ot-detail {
    color: inherit;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .ot-help {
    font-size: 14px;
  }
</style>
