---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/latin-700.css'; // the free-shipping banner
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Drawn from '../components/Drawn.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { drawn } from '../data/assets';
import { TAGLINE, IMAGE_VERSION, WEB_ANALYTICS_TOKEN, FREE_SHIPPING_BANNER } from '../data/store';
import plexFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
// Every link and button is in Rubik Black, like the big titles on the home page photos.
import '@fontsource/rubik/latin-900.css';
import rubikFont from '@fontsource/rubik/files/rubik-latin-900-normal.woff2?url';
import Label from '../components/Label.astro';

interface Props {
  title?: string;
  tab?: 'shop' | 'about' | 'cart';
  /** Main area doesn't scroll itself (the shop feed manages its own scrolling). */
  fill?: boolean;
  description?: string;
  /** Empty the cart before anything is drawn (the order-success page). */
  clearCart?: boolean;
  /** Link-preview image (a path on this site); defaults to the logo card, /og.png. */
  image?: string;
  /** Newsletter sign-up in the footer (the home and about pages). */
  newsletter?: boolean;
  /** The whole title when the link is shared (and in the browser tab), instead of "<title> · tagline". */
  shareTitle?: string;
  /** Leave the footer off (the private orders page). */
  footer?: boolean;
  /** Keep the page out of search engines (orders, tracking pages). */
  noindex?: boolean;
  /** The free-shipping banner at the top (on by default, except on private pages). */
  banner?: boolean;
  /** The links float over the page's first photo (home and about), instead of a bar above it. */
  overlay?: boolean;
}

const { title, tab, fill = false, description = TAGLINE, clearCart = false, image = '/og.png', newsletter = false, footer = true, noindex = false, shareTitle, banner = !noindex, overlay = false } = Astro.props;
const showBanner = banner && !!FREE_SHIPPING_BANNER;
const fullTitle = shareTitle ?? (title ? `${title} · GÜSH` : 'GÜSH');
// Shared titles are in Title Case like the tagline ("Blue Thermal"); the site itself stays lowercase.
const titleCase = (s: string) => s.replace(/\b\w/g, (c) => c.toUpperCase());
const ogImageUrl = new URL(image, Astro.site ?? Astro.url);
ogImageUrl.searchParams.set('v', IMAGE_VERSION); // so apps fetch the new image when it changes
const ogImage = ogImageUrl.href;
// This page's public address (pages are built as name.html but served without the .html).
const pageUrl = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site ?? Astro.url).href;
// Hand-drawn digits for numbers the browser fills in (cart count, quantities). Index = digit.
const digitImgs = Array.from({ length: 10 }, (_, d) => drawn(`digit-${d}`));
const digitUrls: string[] | null = null; // the cart count is typed now (Rubik), not the sewn digits
const _sewnDigits = digitImgs.every(Boolean)
  ? await Promise.all(digitImgs.map(async (src) => (await getImage({ src: src!, height: 120, format: 'webp', quality: 'max' })).src))
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <!-- Link previews when the site is shared. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GÜSH" />
    <!-- iMessage shows only the image and title, so the tagline goes in the shared title too. -->
    <meta property="og:title" content={shareTitle ?? (title ? `${titleCase(title)} · ${TAGLINE}` : TAGLINE)} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareTitle ?? (title ? `${title} · GÜSH` : "GÜSH")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{fullTitle}</title>
    <!-- Preloaded so text and the drawn cart count never pop in late. -->
    <link rel="preload" as="font" type="font/woff2" href={plexFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={rubikFont} crossorigin />
    {
      WEB_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: WEB_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body>
    <div class:list={['app', { 'has-banner': showBanner, overlay }]} data-app>
      {
        showBanner && (
          <div class="banner" role="note" aria-label={FREE_SHIPPING_BANNER}>
            <div class="banner-track" aria-hidden="true">
              {Array.from({ length: 2 }, () => (
                <span class="banner-run">
                  {Array.from({ length: 3 }, () => (
                    <span class="banner-item">{FREE_SHIPPING_BANNER}</span>
                  ))}
                </span>
              ))}
            </div>
          </div>
        )
      }
      <header class="topbar">
        <nav class="tabs" aria-label="main">
          <a href="/shop" class="tab" aria-current={tab === 'shop' ? 'page' : undefined} aria-label="shop">
            <Label text="shop" size={16} webSize={20} underline />
          </a>
          <a href="/about" class="tab" aria-current={tab === 'about' ? 'page' : undefined} aria-label="about">
            <Label text="about" size={16} webSize={20} underline />
          </a>
        </nav>
        <a href="/cart" class="tab cart-tab" aria-current={tab === 'cart' ? 'page' : undefined} aria-label="cart">
          <Label text="cart" size={16} webSize={20} underline />
          <span class="cart-count" data-cart-count></span>
          <script is:inline define:vars={{ digitUrls, clearCart }}>
            // Runs right here, before the first paint, so the count never flashes a wrong number.
            // (Same storage key and drawing as scripts/cart.ts + scripts/digits.ts, which take over after.)
            window.GUSH_DIGITS = digitUrls;
            var n = 0;
            try {
              if (clearCart) localStorage.removeItem('gush-cart');
              (JSON.parse(localStorage.getItem('gush-cart') || '[]') || []).forEach(function (l) {
                if (l && l.qty > 0) n += l.qty;
              });
            } catch (e) {}
            var el = document.querySelector('[data-cart-count]');
            el.dataset.n = String(n);
            if (digitUrls) {
              el.classList.add('digits');
              String(n).split('').forEach(function (d) {
                var img = document.createElement('img');
                img.src = digitUrls[Number(d)];
                img.alt = '';
                img.draggable = false;
                el.appendChild(img);
              });
            } else el.textContent = n;
            el.closest('a').setAttribute('aria-label', 'cart, ' + n + (n === 1 ? ' item' : ' items'));
          </script>
        </a>
      </header>

      <main class:list={[{ fill }]}>
        <slot />
        <!-- Pages that scroll themselves (the shop) put the footer at the end of their own scrolling. -->
        {!fill && footer && <SiteFooter newsletter={newsletter} />}
      </main>
    </div>

    <script>
      import { updateBadge } from '../scripts/cart';
      updateBadge();

      // The floating links are white over the darker photos, and dark over anything light under them
      // (the sewing scan, the white footer), so they always show.
      const app = document.querySelector<HTMLElement>('[data-app].overlay');
      const scroller = document.querySelector('main');
      const bar = document.querySelector<HTMLElement>('.topbar');
      if (app && scroller && bar) {
        let queued = false;
        const check = () => {
          queued = false;
          const r = bar.getBoundingClientRect();
          const y = r.top + r.height / 2;
          const under = document.elementsFromPoint(r.left + r.width / 2, y).find((el) => !bar.contains(el));
          const panel = under?.closest('.panel');
          app.classList.toggle('past-photos', !panel || panel.classList.contains('light'));
        };
        scroller.addEventListener(
          'scroll',
          () => {
            if (!queued) (queued = true), requestAnimationFrame(check);
          },
          { passive: true },
        );
        check();
      }
      // Back/forward cache restores old pages; refresh the count when that happens.
      addEventListener('pageshow', updateBadge);
    </script>
  </body>
</html>
