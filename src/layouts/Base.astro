---
import '@fontsource/special-elite';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Drawn from '../components/Drawn.astro';
import DrawnToggle from '../components/DrawnToggle.astro';
import { mustDrawn } from '../data/assets';

interface Props {
  title?: string;
  tab?: 'shop' | 'about' | 'cart';
  /** Main area doesn't scroll itself (the shop feed manages its own scrolling). */
  fill?: boolean;
  description?: string;
}

const { title, tab, fill = false, description = 'GÜSH clothing' } = Astro.props;
const fullTitle = title ? `${title} · GÜSH` : 'GÜSH';
const headerPaper = await getImage({ src: mustDrawn('header-paper'), width: 1000, format: 'webp' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="app">
      <header class="topbar" style={`background-image:url(${headerPaper.src})`}>
        <a href="/" class="brand" aria-label="GÜSH home">
          <Drawn name="logo" h={80} alt="GÜSH" loading="eager" />
        </a>
        <nav class="tabs" aria-label="main">
          <a href="/shop" class="tab" aria-current={tab === 'shop' ? 'page' : undefined} aria-label="shop">
            <DrawnToggle name="tab-shop" h={22} />
          </a>
          <a href="/about" class="tab" aria-current={tab === 'about' ? 'page' : undefined} aria-label="about">
            <DrawnToggle name="tab-about" h={22} />
          </a>
          <a href="/cart" class="tab cart-tab" aria-current={tab === 'cart' ? 'page' : undefined} aria-label="cart">
            <DrawnToggle name="cart-box" h={30} />
            <span class="cart-count" data-cart-count>0</span>
          </a>
        </nav>
      </header>

      <main class:list={[{ fill }]}>
        <slot />
      </main>
    </div>

    <script>
      import { updateBadge } from '../scripts/cart';
      updateBadge();
      // Back/forward cache restores old pages; refresh the count when that happens.
      addEventListener('pageshow', updateBadge);
    </script>
  </body>
</html>
