---
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Drawn from '../components/Drawn.astro';
import DrawnToggle from '../components/DrawnToggle.astro';
import { drawn } from '../data/assets';

interface Props {
  title?: string;
  tab?: 'shop' | 'about' | 'cart';
  /** Main area doesn't scroll itself (the shop feed manages its own scrolling). */
  fill?: boolean;
  description?: string;
}

const { title, tab, fill = false, description = 'GÜSH clothing' } = Astro.props;
const fullTitle = title ? `${title} · GÜSH` : 'GÜSH';
// Hand-drawn digits for numbers the browser fills in (cart count, quantities). Index = digit.
const digitImgs = Array.from({ length: 10 }, (_, d) => drawn(`digit-${d}`));
const digitUrls = digitImgs.every(Boolean)
  ? await Promise.all(digitImgs.map(async (src) => (await getImage({ src: src!, height: 120, format: 'webp', quality: 'max' })).src))
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <a href="/" class="brand" aria-label="GÜSH home">
          <Drawn name="logo" h={100} webH={140} alt="GÜSH" loading="eager" />
        </a>
        <nav class="tabs" aria-label="main">
          <a href="/shop" class="tab" aria-current={tab === 'shop' ? 'page' : undefined} aria-label="shop">
            <DrawnToggle name="tab-shop" h={32} webH={62} />
          </a>
          <a href="/about" class="tab" aria-current={tab === 'about' ? 'page' : undefined} aria-label="about">
            <DrawnToggle name="tab-about" h={32} webH={62} />
          </a>
        </nav>
        <a href="/cart" class="tab cart-tab" aria-current={tab === 'cart' ? 'page' : undefined} aria-label="cart">
          <DrawnToggle name="cart-box" h={42} webH={73} />
          <span class="cart-count" data-cart-count>0</span>
        </a>
      </header>
      <div class="divider" aria-hidden="true">
        <Drawn name="bee-line" h={38} fullWidth loading="eager" />
      </div>

      <main class:list={[{ fill }]}>
        <slot />
      </main>
    </div>

    <script is:inline type="application/json" id="digit-urls" set:html={JSON.stringify(digitUrls)} />
    <script>
      import { updateBadge } from '../scripts/cart';
      updateBadge();
      // Back/forward cache restores old pages; refresh the count when that happens.
      addEventListener('pageshow', updateBadge);
    </script>
  </body>
</html>
